#!/bin/sh
# ============================================================================
# myos-update  -  カーネルを入れ替える root 側の手先
#
#   myos-update status              いま入っているものと、出ているもの
#   myos-update check               入れ替える価値があるか (0 = ある)
#   myos-update apply               カーネルを取ってきて入れ替える
#   myos-update apply-system        システムまるごと入れ替える (ルート A/B)
#   myos-update rollback-info       控えがあるか
#
# sudoers で NOPASSWD にするので、ここも「一般ユーザーが root として
# 出来ること」の境界になる。取ってくる先は決め打ちで、引数から
# URL を渡せるようにはしない。渡せるようにすると、任意の中身を
# 生領域へ書かせる口になる。
#
# --- 何を比べるか ------------------------------------------------------------
#
# 版の文字列 (1.5.3 と 1.5.4) を比べてはいけない。z を上げた版は
# 「カーネルを作り直していない」という意味なので、中身は 1 バイトも
# 違わない。それを落として書くと、21MB 落として生領域を書き換えて、
# 得るものが何も無いことになる。書き込みには必ず危険が伴うのだから、
# 得るものが無いなら書かないのが正しい。
#
# なので比べるのは実物の sha256。
#
#   いま起動に使っているもの: myos-writeboot --kernel-sha が
#     生領域から読み直して数える。控えを持たないので、ずれようが無い。
#   出ているもの: リリースの .sha256 (92 バイト)。本体を落とす前に
#     取れるので、要らないと分かった時点で 21MB を諦められる。
#
# --- 版の文字列をどう扱うか --------------------------------------------------
#
# このコマンドはカーネルと initramfs しか書き換えない。GUI も
# インストーラも /usr の中身もそのまま残る。だから version.conf の
# version (= 入れたときの ISO の版) を書き換えてはいけない。書き換えると
# 「1.5.4 です」と名乗りながら 1.5.4 で直した GUI の不具合を全部
# 抱えている機械が出来上がり、次に報告を受けたとき版番号から原因を
# 追えなくなる。
#
# カーネルの版は kernel = として別に持つ。こちらはただの見出しで、
# 入れ替えるかどうかの判断には使わない (判断は上のとおり sha256)。
# だから書き損じても表示が古くなるだけで、動きは壊れない。
#
# 入れ替えの安全は myos-writeboot 側が持っている:
#   使っていないほうの置き場へ書く -> 読み返す -> 控えを取る -> 差し替え
# 差し替える前に落ちれば古いほうがそのまま生きている。
# 新しいカーネルが動かなかったときは、起動中に R を押すと 1 つ前で立つ。
# ============================================================================
set -e

REPO="Kazuhiro-Tokumoto/OS"
API="https://api.github.com/repos/$REPO/releases/latest"
CONF=/etc/myos/version.conf
WORK=/var/tmp/myos-update
WRITEBOOT=/usr/local/bin/myos-writeboot

die() { echo "myos-update: $1" >&2; exit 1; }

# --- 手が入った設定を新しいルートへ連れて行く -------------------------------
#
# 連れて行くものを手で並べる方式をやめた。**並べ忘れると黙って消える。**
# 実際、アカウント (/etc/passwd, /etc/shadow) を並べ忘れて、入れ替えた
# 瞬間に誰も入れない機械が出来た。手で並べる方式そのものが間違いで、
# 機械に数えさせるべきだった。
#
# 出荷時の /etc の姿は etc.sums に焼いてある (build_rootfs.sh)。いまの
# /etc と見比べれば、**この機械で手が入ったものだけ**が機械的に出る。
#
# 触っていないものは写さない。新しい版で直っているかもしれないので、
# 出荷時のままのものは新しい側のものを使うのが正しい。
#
# 名前に空白の入ったファイルは扱えない。/etc には無いものとする。
carry_etc() {
    cu="$1"; nw="$2"
    base="$cu/etc/myos/etc.sums"
    if [ ! -f "$base" ]; then
        echo "myos-update: 出荷時の記録がありません (古い版から上げた?)"
        echo "myos-update: 設定は主なものだけ写します"
        return 1
    fi

    grep '^F ' "$base" | awk '{print $3, $2}' | sort > "$WORK/etc.base"
    ( cd "$cu/etc" && find . -type f -exec sha256sum {} + 2>/dev/null ) |
        awk '{print $2, $1}' | sort > "$WORK/etc.cur"
    awk 'NR==FNR { h[$1] = $2; next }
         (!($1 in h)) || h[$1] != $2 { print $1 }' \
        "$WORK/etc.base" "$WORK/etc.cur" > "$WORK/etc.changed"

    grep '^L ' "$base" | awk '{print $3, $2}' | sort > "$WORK/link.base"
    ( cd "$cu/etc" && find . -type l -printf '%p %l\n' 2>/dev/null ) |
        sort > "$WORK/link.cur"
    awk 'NR==FNR { t[$1] = $2; next }
         (!($1 in t)) || t[$1] != $2 { print $1 }' \
        "$WORK/link.base" "$WORK/link.cur" >> "$WORK/etc.changed"

    n=0
    while IFS= read -r rel; do
        rel=${rel#./}
        case "$rel" in
            # 使う人は carry_users が丁寧に混ぜる。丸ごと写すと、
            # 新しい版が増やしたシステム用の利用者を消してしまう。
            passwd|shadow|group|gshadow|passwd-|shadow-|group-|gshadow-)
                continue ;;
            # 入っているライブラリと対になって作られるもの。古いものを
            # 新しい根に置くと、無い .so を指したままになる。
            ld.so.cache|mtab)
                continue ;;
            # dpkg が管理する。古い行き先は新しい根に無いことがある。
            alternatives/*)
                continue ;;
            # 起動のたびに dhclient が書く。写す意味が無い。
            resolv.conf)
                continue ;;
            # この仕組み自身のもの。版は下で新しいものに書き換える。
            myos/etc.sums|myos/packages.base|myos/version.conf)
                continue ;;
        esac
        d=$(dirname "$rel")
        [ "$d" = "." ] || mkdir -p "$nw/etc/$d" 2>/dev/null
        cp -a "$cu/etc/$rel" "$nw/etc/$rel" 2>/dev/null && n=$((n + 1))
    done < "$WORK/etc.changed"
    echo "myos-update: 手が入った設定を $n 個引き継ぎました"
    return 0
}

# --- あとから入れたものを新しいルートへ写す ---------------------------------
#
# ルートを丸ごと入れ替えるので、apt で入れたものは新しい側に無い。
# 「一覧を残すので入れ直してください」で済ませていたが、それは逃げ。
# **入れ替えたらアプリが消える OS** は使い物にならない。
#
# 実際に写す。どのファイルがどのパッケージのものかは dpkg が知っている
# ので、聞けばいい。
#
#   1. 出荷時に入っていなかったパッケージを数える (依存も含めて全部)
#   2. dpkg -L でファイルを引いて、新しい側へ写す
#   3. dpkg の帳簿 (info と status) も写す。写さないと apt から見て
#      「入っていない」ことになり、次の更新や削除で食い違う
#   4. ldconfig をかけ直す。写しただけでは共有ライブラリの索引が古い
#
# 新しい側に既にあるファイルは触らない。新しい版のものが正しい。
#
# 同じ Debian の版 (bookworm) の中での話なので、共有ライブラリの
# soname は変わらない。だから写した実行ファイルはそのまま動く。
# 版をまたぐときは、この前提が崩れるので考え直すこと。
carry_apps() {
    cu="$1"; nw="$2"
    base="$cu/etc/myos/packages.base.all"
    if [ ! -f "$base" ]; then
        # 古い版から上げたとき。写す判断ができないので、せめて
        # 何を入れ直せばいいかを残す。
        b2="$cu/etc/myos/packages.base"
        [ -f "$b2" ] || return 0
        apt-mark showmanual 2>/dev/null | sort -u > "$WORK/pkg.now"
        comm -13 "$b2" "$WORK/pkg.now" > "$nw/etc/myos/packages.extra"
        if [ -s "$nw/etc/myos/packages.extra" ]; then
            echo "myos-update: 出荷時の記録が足りないので、アプリは写せません。"
            echo "myos-update: 新しいほうの初回起動で入れ直せます。"
        else
            rm -f "$nw/etc/myos/packages.extra"
        fi
        return 0
    fi

    dpkg-query -W -f '${binary:Package}\n' 2>/dev/null |
        sort -u > "$WORK/pkg.all.now"
    comm -13 "$base" "$WORK/pkg.all.now" > "$WORK/pkg.extra.all"

    cnt=$(wc -l < "$WORK/pkg.extra.all")
    [ "$cnt" -gt 0 ] || { echo "myos-update: あとから入れたものはありません"; return 0; }

    echo "myos-update: あとから入れたもの $cnt 個を写しています"

    before=$(du -sk "$nw" 2>/dev/null | cut -f1)

    while IFS= read -r pkg; do
        [ -n "$pkg" ] || continue
        dpkg -L "$pkg" 2>/dev/null | while IFS= read -r f; do
            # /etc は carry_etc の担当。あちらは「手が入ったか」を見て
            # いるので、二重に写すと判断を上書きしてしまう。
            case "$f" in /etc|/etc/*) continue ;; esac

            # 実体が無いもの (dpkg -L は消されたファイルも並べる) は飛ばす。
            # 壊れたリンクは -e が偽になるので -L でも見る。
            if [ ! -e "$cu$f" ] && [ ! -L "$cu$f" ]; then continue; fi

            if [ -d "$cu$f" ] && [ ! -L "$cu$f" ]; then
                mkdir -p "$nw$f" 2>/dev/null
                continue
            fi

            # 新しい側にあるものは触らない。新しい版のものが正しい。
            if [ -e "$nw$f" ] || [ -L "$nw$f" ]; then continue; fi

            mkdir -p "$(dirname "$nw$f")" 2>/dev/null
            cp -a "$cu$f" "$nw$f" 2>/dev/null
        done

        # dpkg の帳簿。list / md5sums / postinst など。
        for m in "$cu/var/lib/dpkg/info/$pkg."* \
                 "$cu/var/lib/dpkg/info/$pkg:"*; do
            [ -e "$m" ] || continue
            cp -a "$m" "$nw/var/lib/dpkg/info/" 2>/dev/null
        done
    done < "$WORK/pkg.extra.all"

    # status の段落を足す。ここを写さないと apt から見て「入っていない」
    # ことになり、次の更新で消されたり二重に入れられたりする。
    # 段落の区切りを確かめてから足す。dpkg は**空行で**段落を切るので、
    # 詰めて書くと前のパッケージと 1 つに読まれて帳簿が壊れる。
    # 空行が余分にあるぶんには読み飛ばされるので、必ず 1 つ入れる。
    printf '\n' >> "$nw/var/lib/dpkg/status"

    # 一覧を読み終えてから段落モードにする。RS='' を先に立てると、
    # getline も段落モードで読んでしまい、一覧が丸ごと 1 行として
    # 入る (= 何にも一致しない)。手元で通して初めて気づいた。
    awk -v list="$WORK/pkg.extra.all" '
        BEGIN {
            while ((getline p < list) > 0) if (p != "") want[p] = 1
            RS = ""
        }
        {
            name = ""
            n = split($0, L, "\n")
            for (i = 1; i <= n; i++)
                if (L[i] ~ /^Package: /) { name = substr(L[i], 10); break }
            if (name in want) printf "%s\n\n", $0
        }' "$cu/var/lib/dpkg/status" >> "$nw/var/lib/dpkg/status" 2>/dev/null

    # 共有ライブラリの索引を作り直す。写しただけでは古いまま。
    chroot "$nw" ldconfig 2>/dev/null || true

    # 何を写したかは残しておく。うまく動かないときの入れ直し用。
    apt-mark showmanual 2>/dev/null | sort -u > "$WORK/pkg.now"
    comm -13 "$cu/etc/myos/packages.base" "$WORK/pkg.now" \
        > "$nw/etc/myos/packages.carried" 2>/dev/null

    after=$(du -sk "$nw" 2>/dev/null | cut -f1)
    mb=$(( (after - before) / 1024 ))
    echo "myos-update: 約 ${mb} MB を写しました"
}

# --- 使う人を新しいルートへ連れて行く ---------------------------------------
#
# squashfs は**作った人の機械のもの**なので、/etc/passwd も /etc/shadow も
# 「まだ誰も居ない」状態で入っている。ここを写さないと、入れ替えた瞬間に
# 自分のパスワードで入れなくなる。実機で踏んだ。
#
# 丸ごと写すのは採らない。新しい版でパッケージが増えていると、そちらが
# 作ったシステム用の利用者 (pulse, messagebus など) を消してしまう。
# **人間ぶん (UID >= 1000) だけ**を、新しい側に無ければ足す。
#
# 副グループも要る。sudo を落とすと「入れ替えたら管理者権限が消えた人」が
# 出来上がる。パスワードで入れないのと同じくらい困る。
#
# 引数で根を受けるのは、手元で試せるようにするため。本番は ("" 新しい根)。
carry_users() {
    cu="$1"      # いまの根 (空文字 = /)
    nw="$2"      # 新しい根

    # 新しい側のグループ行に、その人を足す。
    # group も gshadow も所属は 4 つ目の欄なので、同じ処理で両方いける。
    # 片方だけ直すと usermod や grpck が食い違いを言い出す。
    _add_member() {   # $1 = ファイル, $2 = グループ名, $3 = 使う人
        [ -f "$1" ] || return 0
        grep -q "^$2:" "$1" || return 0
        awk -F: -v g="$2" -v u="$3" 'BEGIN{OFS=":"}
            $1 == g {
                n = split($4, m, ",")
                for (i = 1; i <= n; i++) if (m[i] == u) { print; next }
                $4 = ($4 == "" ? u : $4 "," u)
            }
            { print }' "$1" > "$1.new" && cat "$1.new" > "$1"
        rm -f "$1.new"
    }

    for u in $(awk -F: '$3 >= 1000 && $3 != 65534 {print $1}' "$cu/etc/passwd"); do
        grep -q "^$u:" "$nw/etc/passwd" ||
            grep "^$u:" "$cu/etc/passwd" >> "$nw/etc/passwd"
        grep -q "^$u:" "$nw/etc/shadow" ||
            grep "^$u:" "$cu/etc/shadow" >> "$nw/etc/shadow"

        # 主グループ。同じ名前が無ければ行ごと写す。
        gid=$(awk -F: -v n="$u" '$1 == n {print $4}' "$cu/etc/passwd")
        gname=$(awk -F: -v g="$gid" '$3 == g {print $1; exit}' "$cu/etc/group")
        if [ -n "$gname" ] && ! grep -q "^$gname:" "$nw/etc/group"; then
            grep "^$gname:" "$cu/etc/group" >> "$nw/etc/group"
            grep "^$gname:" "$cu/etc/gshadow" >> "$nw/etc/gshadow" 2>/dev/null
        fi

        # 副グループ (sudo / audio / video / plugdev ...)
        for g in $(awk -F: -v n="$u" '{ split($4, m, ",")
                                        for (i in m) if (m[i] == n) print $1 }' \
                       "$cu/etc/group"); do
            _add_member "$nw/etc/group"   "$g" "$u"
            _add_member "$nw/etc/gshadow" "$g" "$u"
        done
    done

    # root の状態も連れて行く。セットアップが passwd -l で施錠しているので、
    # 写さないと**施錠前の状態に戻る**。
    rootline=$(grep "^root:" "$cu/etc/shadow" 2>/dev/null)
    if [ -n "$rootline" ]; then
        grep -v "^root:" "$nw/etc/shadow" > "$nw/etc/shadow.new" &&
            printf '%s\n' "$rootline" >> "$nw/etc/shadow.new" &&
            cat "$nw/etc/shadow.new" > "$nw/etc/shadow"
        rm -f "$nw/etc/shadow.new"
    fi
}

conf_get() {
    sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" "$CONF" 2>/dev/null | head -1
}

# version.conf の 1 行を書き換える。無ければ足す。
conf_set() {
    [ -f "$CONF" ] || printf '# myOS: いま入っている版。\n' > "$CONF"
    if grep -q "^$1[[:space:]]*=" "$CONF" 2>/dev/null; then
        sed -i "s|^$1[[:space:]]*=.*|$1 = $2|" "$CONF"
    else
        printf '%s = %s\n' "$1" "$2" >> "$CONF"
    fi
}

os_version() { conf_get version; }

# カーネルの版は見出しでしかない。記録が無ければ、入れたときの ISO の版
# がそのままカーネルの版でもあるので、そちらを出す。
kernel_version() {
    k=$(conf_get kernel)
    [ -n "$k" ] && { echo "$k"; return; }
    os_version
}

# 指定した区画が **どこかに** マウントされていたら外す。
#
# 入れ替え先を mkfs する前に要る。実機で
#
#   /dev/sda5 を空けています
#   /dev/sda5 is mounted; will not make a filesystem here!
#   myos-update: /dev/sda5 を空けられません
#
# と止まった。前の apply-system が途中で転んで、$WORK/mnt を
# 外さないまま死んでいたのが原因。mkfs は「マウント中の区画は
# 触らない」という正しい判断をしただけで、悪いのはこちら。
#
# いま動いているルートは A/B の選び方から必ず対象外になるので、
# ここで外して困る相手は無い。
free_dev() {
    n=0
    while [ "$n" -lt 8 ]; do
        mp=$(awk -v d="$1" '$1 == d { print $2; exit }' /proc/mounts)
        [ -n "$mp" ] || return 0
        echo "$1 が $mp にあるので外します"
        umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || return 1
        n=$((n + 1))
    done
    return 1
}

# 起動に使っているディスクと、生領域の場所を割り出す。
# 入れたときの値は /etc/myos/boot.conf に置いてある。
boot_info() {
    [ -f /etc/myos/boot.conf ] || die "/etc/myos/boot.conf がありません"
    . /etc/myos/boot.conf
    [ -n "$disk" ] && [ -n "$root" ] && [ -n "$bootlba" ] ||
        die "/etc/myos/boot.conf の中身が足りません"
    # roota / rootb は A/B が取れた機械にだけ書いてある。無くてもよい。
    : "${roota:=}" "${rootb:=}" "${home:=}"
}

# いま生領域に乗っているカーネルの sha256。
local_sha() {
    [ -x "$WRITEBOOT" ] || return 1
    "$WRITEBOOT" --kernel-sha "$disk" 2>/dev/null
}

latest_json() {
    curl -fsSL --max-time 30 "$API" 2>/dev/null || die "リリースの情報を取れません"
}

latest_version() {
    latest_json | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p' |
        head -1
}

# 出ている版のカーネルの sha256。本体ではなく 92 バイトのほうを取る。
remote_sha() {
    curl -fsSL --max-time 60 \
        "https://github.com/$REPO/releases/download/v$1/myos-kernel-$1.bzImage.sha256" \
        2>/dev/null | awk '{print $1; exit}'
}

case "$1" in
status)
    echo "os        = $(os_version)"
    echo "kernel    = $(kernel_version)"
    new=$(latest_version 2>/dev/null || true)
    if [ -z "$new" ]; then
        echo "latest    = (取れません)"
        echo "kernelnew = unknown"
    else
        echo "latest    = $new"
        # カーネルを入れ替える意味があるかどうか。
        # 版が違っても中身が同じなら no。それが z を上げた版。
        if boot_info 2>/dev/null && cur=$(local_sha) && [ -n "$cur" ] &&
           want=$(remote_sha "$new") && [ -n "$want" ]; then
            if [ "$cur" = "$want" ]; then
                echo "kernelnew = no"
            else
                echo "kernelnew = yes"
            fi
        else
            echo "kernelnew = unknown"
        fi
    fi
    if boot_info 2>/dev/null; then
        echo "disk      = $disk (生領域 $bootlba)"
        if [ -n "$roota" ] && [ -n "$rootb" ]; then
            echo "system    = A/B ($roota / $rootb、いま $root)"
        else
            echo "system    = 1 本 ($root)"
        fi
    fi
    ;;

check)
    boot_info
    new=$(latest_version)
    [ -n "$new" ] || die "最新の版が分かりません"
    cur=$(local_sha) || die "いまのカーネルを読めません"
    want=$(remote_sha "$new")
    [ -n "$want" ] || die "出ているカーネルの sha256 を取れません"
    [ "$cur" != "$want" ]
    ;;

apply)
    boot_info
    new=$(latest_version)
    [ -n "$new" ] || die "最新の版が分かりません"

    cur=$(local_sha) || die "いまのカーネルを読めません"
    want=$(remote_sha "$new")
    [ -n "$want" ] || die "出ているカーネルの sha256 を取れません"

    if [ "$cur" = "$want" ]; then
        # 版の数字は進んでいても、カーネルは同じもの。書く意味が無い。
        # 見出しだけ合わせておく。
        conf_set kernel "$new"
        echo "myos-update: カーネルは既に最新です ($new と同じ中身)。"
        echo "myos-update: この版でカーネルは作り直されていないので、"
        echo "myos-update: 書き換えるものがありません。"
        exit 0
    fi

    rm -rf "$WORK"; mkdir -p "$WORK"
    base="https://github.com/$REPO/releases/download/v$new"
    k="myos-kernel-$new.bzImage"

    echo "取得中: $k"
    curl -fL --max-time 900 -o "$WORK/$k"        "$base/$k" ||
        die "カーネルを取れません"
    curl -fsSL --max-time 60 -o "$WORK/$k.sha256" "$base/$k.sha256" ||
        die "sha256 を取れません"

    echo "照合中"
    ( cd "$WORK" && sha256sum -c "$k.sha256" ) ||
        die "sha256 が合いません (壊れたものを書くわけにいかない)"

    # ファームウェアの initramfs は、その場で作り直す。
    # 入れたときと同じ中身とは限らない (ファームを足したかもしれない)。
    #
    # ここで失敗したら *止まる*。黙って fw="" で進むと、いま起動して
    # いる機械から initramfs を取り上げることになる。ファームを要る GPU
    # (nouveau / radeon / amdgpu) は probe がルートのマウントより先に
    # 走るので、次の再起動で画面が真っ暗になる。
    # 「カーネルを新しくしたら映らなくなった」の正体がこれ。
    fw=""
    if [ -x /usr/local/bin/myos-mkfwinit ]; then
        echo "ファームウェアをまとめ中"
        # パイプに繋ぐと終了状態が tee のものになって、失敗が
        # 「成功」に化ける。ログはファイルに取ってから出す。
        if /usr/local/bin/myos-mkfwinit / "$WORK/fw.cpio.gz" \
                > /var/log/myos-fwinit.log 2>&1; then
            fw="--initrd $WORK/fw.cpio.gz"
        fi
        cat /var/log/myos-fwinit.log
        [ -n "$fw" ] && [ -s "$WORK/fw.cpio.gz" ] || die \
"ファームウェアの initramfs を作れませんでした (/var/log/myos-fwinit.log)。
このまま書くと、いま映っている画面が次の起動で真っ暗になります。
カーネルは入れ替えていません。"
    fi

    # NVIDIA の公式ドライバを入れてある機械は、先に nouveau を戻す。
    #
    # あのドライバは動いているカーネルに合わせて作ったモジュールなので、
    # カーネルを入れ替えると **必ず読み込めなくなる**。
    # そのとき nouveau.modeset=0 が残っていると、代わりに画面を持つ者が
    # 誰も居なくなり、次の起動が真っ暗になる。
    # 「速いけれど起動しない」より「遅いけれど起動する」を選ぶ。
    # 入れ直しは再起動のあとに案内する。
    if [ -f /etc/myos/nvidia.conf ] &&
       grep -q '^run[[:space:]]*=[[:space:]]*[^[:space:]]' \
            /etc/myos/nvidia.conf 2>/dev/null; then
        echo "NVIDIA のドライバが入っているので、いったん nouveau に戻します"
        "$WRITEBOOT" --cmdline-del nouveau.modeset "$disk" || true
        nvidia_was=1
    else
        nvidia_was=0
    fi

    echo "書き込み中 (使っていないほうの置き場へ)"
    # shellcheck disable=SC2086
    "$WRITEBOOT" --kernel "$WORK/$k" $fw --keep-cmdline \
        "$disk" "$root" "$bootlba"

    # 書けたことを、控えではなく実物で確かめる。
    got=$(local_sha) || die "書いたあとの読み直しに失敗しました"
    [ "$got" = "$want" ] ||
        die "書いたものが合いません (テーブルは差し替わっていません)"

    conf_set kernel "$new"
    rm -rf "$WORK"
    echo "myos-update: カーネルを $new に入れ替えました。"
    if [ "$nvidia_was" = "1" ]; then
        echo
        echo "myos-update: NVIDIA のドライバはカーネルに合わせて作った"
        echo "myos-update: ものなので、いまのままでは読み込めません。"
        echo "myos-update: nouveau に戻してあるので画面は出ます。"
        echo "myos-update: 再起動したあと、こうすると入れ直せます:"
        echo "myos-update:     sudo myos-nvidia setup"
        echo "myos-update:     sudo myos-nvidia install <前と同じ .run>"
        echo
    fi
    echo "myos-update: 再起動すると新しいカーネルで立ちます。"
    echo "myos-update: 動かなかったら、起動中に R を押しっぱなしにすると"
    echo "myos-update: 1 つ前のカーネルで立ちます。"
    echo "myos-update: (GUI などカーネル以外は $(os_version) のままです)"
    ;;

apply-system)
    # システム (ルート) をまるごと入れ替える。
    #
    # カーネルの更新では GUI の直しが届かない。squashfs の中に居るので、
    # そこを入れ替えないと何も変わらない。区画を A/B で切ってある機械
    # では、使っていないほうへ展開して起動先を切り替えるだけで済む。
    #
    # 危ない橋を渡らない順番:
    #   1. 落とす        (まだ何も書いていない)
    #   2. 照合する      (壊れたものを展開しない)
    #   3. 空けて展開    (使っていないほう。いま動いている側は無傷)
    #   4. 起動先を切替  (テーブル 1 セクタ。控えは LBA 21 へ)
    # 3 の途中で落ちても、いま動いている側は何も変わらない。
    # 4 のあとで新しい側が起動しなければ、起動中に R で戻る。
    boot_info
    [ -n "$roota" ] && [ -n "$rootb" ] || \
        die "この機械はルートが 1 本です (入れ直しが要ります)"

    new=$(latest_version)
    [ -n "$new" ] || die "最新の版が分かりません"
    cur=$(os_version)
    if [ "$cur" = "$new" ]; then
        echo "myos-update: 既に $cur です"
        exit 0
    fi

    # いま動いていないほうへ入れる。root= と見比べれば分かる。
    if [ "$root" = "$roota" ]; then target="$rootb"; else target="$roota"; fi
    echo "myos-update: いま $root で動いています。$target へ入れます。"

    rm -rf "$WORK"; mkdir -p "$WORK"
    base="https://github.com/$REPO/releases/download/v$new"
    r="myos-root-$new.squashfs"

    echo "取得中: $r"
    curl -fL --max-time 1800 -o "$WORK/$r"        "$base/$r" ||
        die "システムを取れません"
    curl -fsSL --max-time 60 -o "$WORK/$r.sha256" "$base/$r.sha256" ||
        die "sha256 を取れません"

    echo "照合中"
    ( cd "$WORK" && sha256sum -c "$r.sha256" ) ||
        die "sha256 が合いません (壊れたものを展開するわけにいかない)"

    # 途中で転んでも、マウントを残したまま死なないようにする。
    # 残すと **次の apply-system が mkfs できなくなる** (実機で踏んだ)。
    # die は exit するので、これで拾える。
    trap 'umount "$WORK/sq" 2>/dev/null; umount "$WORK/mnt" 2>/dev/null' \
         EXIT INT TERM

    echo "$target を空けています"
    free_dev "$target" || die "$target のマウントを外せません"
    mkfs.ext4 -F -q -m 0 -L myos "$target" || die "$target を空けられません"

    mkdir -p "$WORK/mnt" "$WORK/sq"
    mount "$target" "$WORK/mnt" || die "$target をマウントできません"
    mount -t squashfs -o ro,loop "$WORK/$r" "$WORK/sq" || {
        umount "$WORK/mnt"; die "落としたシステムを開けません"; }

    echo "展開中 (数分かかります)"
    if ! cp -a "$WORK/sq/." "$WORK/mnt/"; then
        umount "$WORK/sq"; umount "$WORK/mnt"
        die "展開に失敗しました (起動先は切り替えていません)"
    fi

    # 入れた機械に合わせた設定を引き継ぐ。squashfs は作った人の
    # ものなので、そのままだと fstab も boot.conf も合わない。
    for keep in etc/fstab etc/myos/boot.conf etc/myos/version.conf \
                etc/adjtime etc/localtime etc/timezone \
                etc/myos/display.conf \
                etc/default/keyboard etc/X11/xorg.conf.d/10-keyboard.conf; do
        if [ -e "/$keep" ]; then
            mkdir -p "$WORK/mnt/$(dirname "$keep")"
            cp -a "/$keep" "$WORK/mnt/$keep" 2>/dev/null || true
        fi
    done
    # 手が入った設定を丸ごと引き継ぐ。下の決め打ちの一覧より先に
    # やる (etc.sums が無い古い版から上げたときは、下だけが効く)。
    carry_etc "" "$WORK/mnt"

    # 無線の合言葉も機械のもの。写さないと網に繋がらなくなる。
    for w in /etc/myos/wpa-*.conf; do
        [ -e "$w" ] || continue
        cp -a "$w" "$WORK/mnt/etc/myos/" 2>/dev/null || true
    done

    # 使う人。ここを落とすと、入れ替えた瞬間に自分のパスワードで
    # 入れなくなる。carry_etc のあとにやること (あちらは passwd を
    # 避けて通るので、混ぜるのはこちらの仕事)。
    carry_users "" "$WORK/mnt"

    # あとから入れたものの一覧を置いておく。新しいほうの初回起動で
    # 入れ直しを勧める。
    carry_apps "" "$WORK/mnt"

    # 入れ直しの扱いにしない。使う人を作り直させると、home の中身と
    # 食い違って別人になってしまう。
    : > "$WORK/mnt/etc/myos/setup-done" 2>/dev/null || true
    [ -e /etc/myos/login.conf ] && \
        cp -a /etc/myos/login.conf "$WORK/mnt/etc/myos/login.conf" 2>/dev/null
    # 版だけは新しいものにする。
    printf '# myOS: 入れたときの ISO の版。\nversion = %s\n' "$new" \
        > "$WORK/mnt/etc/myos/version.conf" 2>/dev/null || true

    # 新しい根の apt の一覧は空 (ISO を小さくするために消してある)。
    # 入れ替えた最初の起動で作り直させる。これを置き忘れると
    # 「更新したら apt install が全部 候補:(なし) になった」になる。
    : > "$WORK/mnt/etc/myos/apt-refresh" 2>/dev/null || true

    sync
    umount "$WORK/sq"; umount "$WORK/mnt"

    echo "起動先を切り替え中"
    /usr/local/bin/myos-writeboot --switch-root "$target" "$disk" ||
        die "切り替えに失敗しました (展開したものは残っていますが、起動先は今までのままです)"

    rm -rf "$WORK"
    echo "myos-update: $cur -> $new。再起動すると新しいほうで立ちます。"
    echo "myos-update: 動かなかったら、起動中に R を押しっぱなしにすると"
    echo "myos-update: 前のほうで立ちます。自分のファイル (/home) は"
    echo "myos-update: どちらでも同じものが見えます。"

    # 生領域に GPU のファームウェアが積まれていない機械には、そう言う。
    # 1.5.x で入れたものは全部この状態になっている (原因は
    # myos-mkfwinit の頭のコメント)。ルートを入れ替えても、生領域は
    # 触っていないので直らない。直す口は用意してあるので案内する。
    if ! /usr/local/bin/myos-writeboot --info "$disk" 2>/dev/null |
         grep -q "initramfs    : LBA"; then
        echo
        echo "myos-update: この機械の生領域には GPU のファームウェアが"
        echo "myos-update: 積まれていません。NVIDIA / Radeon を挿していると"
        echo "myos-update: 起動しても画面が出ません (S を押しっぱなしで"
        echo "myos-update: 立ち上がるのはこれが理由です)。"
        echo "myos-update: 再起動したあと、こうすると直ります:"
        echo "myos-update:     sudo myos-update fix-graphics"
    fi
    ;;

fix-graphics)
    # 画面が真っ暗になった機械を、その場で直す口。
    #
    # 1.5.x で出したものには、GPU のファームウェアの initramfs が
    # 1 つも入っていない。原因は myos-mkfwinit が regulatory.db の
    # リンク 1 本で exit 1 になり、インストーラがそれを黙って
    # 見逃していたこと (myos-mkfwinit の頭のコメント参照)。
    # 入れ直さなくても、ここで作って書き足せば直る。
    #
    # カーネルには触らない。生領域から取り出して、そのまま書き戻す。
    # 書き先は使っていないほうの置き場なので、失敗しても
    # 起動中に R を押せば今までどおりに戻る。
    boot_info
    [ "$(id -u)" = "0" ] || die "root で実行してください (sudo myos-update fix-graphics)"

    rm -rf "$WORK"; mkdir -p "$WORK"

    echo "いまのカーネルを取り出し中"
    "$WRITEBOOT" --dump-kernel "$WORK/bzImage" "$disk" ||
        die "カーネルを取り出せません"

    echo "ファームウェアをまとめ中"
    /usr/local/bin/myos-mkfwinit / "$WORK/fw.cpio.gz" \
        > /var/log/myos-fwinit.log 2>&1 || true
    cat /var/log/myos-fwinit.log
    [ -s "$WORK/fw.cpio.gz" ] ||
        die "ファームウェアの initramfs を作れませんでした (何も書いていません)"

    echo "書き込み中 (使っていないほうの置き場へ)"
    "$WRITEBOOT" --kernel "$WORK/bzImage" --initrd "$WORK/fw.cpio.gz" \
        --keep-cmdline "$disk" "$root" "$bootlba" ||
        die "書き込みに失敗しました"

    # カーネルが 1 バイトも変わっていないことを、書いたあとに確かめる。
    # ここは書き込みの *あと* なので、合わなくても「何もしていない」
    # わけではない。そう言わないと、直っているのに直っていないと
    # 思わせてしまう (実際そうなった)。
    got=$(local_sha) || die "書いたあとの読み直しに失敗しました"
    want=$(sha256sum "$WORK/bzImage")
    want=${want%% *}
    if [ "$got" != "$want" ]; then
        echo "myos-update: 書いたカーネルの照合が合いませんでした。" >&2
        echo "myos-update:   読み直し $got" >&2
        echo "myos-update:   書いたもの $want" >&2
        echo "myos-update: 書き込み自体は終わっています。中身を見てください:" >&2
        echo "myos-update:     sudo myos-update boot-info" >&2
        echo "myos-update: 元に戻すには、起動中に R を押しっぱなしにします。" >&2
        exit 1
    fi

    rm -rf "$WORK"
    echo
    "$WRITEBOOT" --info "$disk"
    echo
    echo "myos-update: GPU のファームウェアを積みました。"
    echo "myos-update: 再起動すると、S を押さなくても画面が出るはずです。"
    echo "myos-update: 駄目だったら、起動中に R を押しっぱなしにすると"
    echo "myos-update: 1 つ前 (いまの状態) に戻ります。"
    ;;

boot-info)
    # いま生領域に何が書いてあるかを見せるだけ。
    boot_info
    "$WRITEBOOT" --info "$disk"
    ;;

rollback-info)
    boot_info
    # LBA 21 に控えがあるか
    if dd if="$disk" bs=512 skip=21 count=1 2>/dev/null |
       head -c 8 | grep -q MYOSPLD2; then
        echo "backup = yes"
    else
        echo "backup = no"
    fi
    ;;

*)
    die "使い方: myos-update status|check|apply|apply-system|rollback-info|fix-graphics|boot-info"
    ;;
esac
