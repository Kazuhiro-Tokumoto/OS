#!/usr/bin/env python3
# ============================================================================
# myos-audio  -  音をどこから出すかを選ぶ
#
#   myos-audio list        出せる出口を並べる
#   myos-audio set <id>    そこへ切り替える。鳴っているものも連れて行く
#
# なぜ要るか
# ----------
# 実機には出口が複数ある。マザーボードの緑の穴、HDMI のモニタ内蔵
# スピーカー、DisplayPort、光デジタル。どれから出したいかは機械ごとに
# 違うのに、myOS は起動時に決め打ちで選んでいた。
#
#   「HDMI が既定になっていたらアナログへ寄せる」
#
# 実機でよくある「音が出ない」を潰すつもりの処理だったが、HDMI の
# モニタで聞きたい人には**完全に裏目**になる。実際そうなった。
# 決め打ちで当てにいくのをやめて、選べるようにする。
#
# 繋がっていないものを出さない
# ----------------------------
# PulseAudio はポートごとに「挿さっているか」を持っている。ここを見れば
# 「選べるのに音が出ない」を防げる。
#
#   available            挿さっている。出す
#   not available        挿さっていない。**出さない**
#   availability unknown コーデックが判別できない。出す (隠すと詰む)
#
# 書き方が版で違う。pactl 16 (Debian 12) はこう書く:
#
#   hdmi-output-0: HDMI / DisplayPort (type: HDMI, priority: 5900,
#       latency offset: 0 usec, availability group: Legacy 3, not available)
#
# 括弧の**最後の項目**が「挿さっているか」で、"available:" とは書かない。
# 古い pactl は "available: no" と書く。両方読めるようにしてある。
#
# ここを "available:" で探していたせいで、1 つもポートが取れず、実機で
# HDMI を挿しても一覧に出てこなかった。しかも "availability group:" が
# 紛らわしい。あれはポートの識別子で、挿さっているかとは関係が無い。
#
# unknown を隠さないのが肝。古いコーデックはジャック検出を持っていない
# ことがあり、そこを隠すと**唯一の出口が消えて何も選べなくなる**。
#
# プロファイルが off でも分かる
# -----------------------------
# HDMI は、カードのプロファイルが off だと sink が存在しない。だが
# ポートの一覧と available はプロファイルと無関係に出る。だから
# 「挿さっているが今は使えない出口」を見つけて、選ばれたときに
# プロファイルごと切り替えられる。
#
# pactl の出力は翻訳される (日本語環境では項目名まで日本語になる)。
# 読み取る側が壊れるので、必ず LC_ALL=C で呼ぶこと。
# ============================================================================
import os
import re
import subprocess
import sys
import time

ENV = dict(os.environ, LC_ALL="C", LANG="C")


def port_avail(inside):
    """ポートの括弧の中から「挿さっているか」を取る。

    版によって書き方が違うので両方見る。分からなければ unknown。
    unknown は隠さない方針なので、読めなかったときに消えることはない。
    """
    m = re.search(r"available: (\w+)", inside)     # 古い pactl
    if m:
        return m.group(1)
    tail = inside.rsplit(",", 1)[-1].strip()       # 新しい pactl は文で書く
    if tail == "not available":
        return "no"
    if tail == "available":
        return "yes"
    return "unknown"                               # "availability unknown" も


def pactl(*args, check=False):
    try:
        r = subprocess.run(["pactl", *args], capture_output=True,
                           text=True, env=ENV, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return "" if not check else None
    if check and r.returncode != 0:
        return None
    return r.stdout


def parse_cards(text):
    """pactl list cards を読む。

    欲しいのは、カードごとの
      - 名前 (set-card-profile に渡すもの)
      - 見せる名前
      - 出力ポート (説明、available、どのプロファイルに属するか)
      - いま有効なプロファイル
    """
    cards = []
    cur = None
    port = None
    section = None

    for raw in text.splitlines():
        line = raw.strip()
        indent = len(raw) - len(raw.lstrip("\t"))

        if raw.startswith("Card #"):
            # 番号も控える。sinks 側の "Card: #N" はこの番号を指すので、
            # 並び順で数えてはいけない (番号は飛ぶことがある)。
            try:
                num = int(raw.strip()[6:])
            except ValueError:
                num = -1
            cur = {"name": "", "desc": "", "active": "", "ports": [],
                   "index": num}
            cards.append(cur)
            section = None
            port = None
            continue
        if cur is None:
            continue

        if line.startswith("Name:"):
            cur["name"] = line.split(":", 1)[1].strip()
            continue
        if line.startswith("Active Profile:"):
            cur["active"] = line.split(":", 1)[1].strip()
            continue
        if line == "Profiles:":
            section = "profiles"; continue
        if line == "Ports:":
            section = "ports"; port = None; continue
        if line == "Properties:":
            # Properties はカード直下にもポートの下にも出る。
            # インデントで見分ける (ポートの下は深い)。
            section = "cardprops" if indent <= 1 else "portprops"
            continue

        if section == "cardprops" and line.startswith("device.description"):
            cur["desc"] = line.split("=", 1)[1].strip().strip('"')
            continue

        if section == "ports" or section == "portprops":
            # 例: analog-output-lineout: Line Out (type: Line, priority: 9000,
            #      latency offset: 0 usec, availability group: Legacy 1,
            #      not available)
            #
            # 目印は priority:。ポートの行には必ず入っていて、下の
            # Properties の行には入らない。「挿さっているか」の書き方は
            # 版で違うので、行を拾う条件には使わない。
            m = re.match(r"^([A-Za-z0-9_.:+-]+): (.*?) \((.*)\)$", line)
            if m and indent >= 2 and "priority:" in m.group(3):
                port = {"name": m.group(1), "desc": m.group(2),
                        "avail": port_avail(m.group(3)),
                        "profiles": [], "type": ""}
                t = re.search(r"type: (\w+)", m.group(3))
                if t:
                    port["type"] = t.group(1)
                cur["ports"].append(port)
                section = "ports"
                continue
            if port is not None and line.startswith("Part of profile(s):"):
                got = line.split(":", 1)[1]
                port["profiles"] = [p.strip() for p in got.split(",") if p.strip()]
                continue

    return cards


def output_profiles(profiles):
    """そのポートが「出口」として属しているプロファイルだけを返す。

    最初は名前が output: で始まるかだけを見ていた。**これでは足りない。**
    実機で入力のポート (マイク、ライン入力) まで一覧に並んだ。

    プロファイルは足し算で書かれる。

        output:analog-stereo                     出すだけ
        input:analog-stereo                      録るだけ
        output:analog-stereo+input:analog-stereo 両方              <- これ

    マイクは 3 つ目にも属している。頭が output: なので素通りしていた。
    足し算の中に input: が居るなら、そのプロファイルは「出す口」の
    証拠にならない。

    **出しかしないプロファイル**に 1 つでも属していれば出口、と決める。
    マイクはそういうプロファイルを持たないので落ちる。
    """
    got = []
    for name in profiles:
        parts = name.split("+")
        if any(x.startswith("output:") for x in parts) and \
           not any(x.startswith("input:") for x in parts):
            got.append(name)
    return got


def outputs(all_ports=False):
    """選ばせてよい出口を並べる。

    入力しかないポート (マイクなど) は落とす。判定は「出力の
    プロファイルに属しているか」で行う。名前で当てにいくと、
    環境ごとの綴りの違いで漏れる。

    挿さっていないもの (available: no) は出さない。ただし
    **それで 1 つも残らなかったときは、全部出す**。

    選べるものが無い画面を出しても、使う人には打つ手が無い。
    ジャック検出が壊れている機械や、検出を持たない古いコーデックで
    そうなる。「出しても鳴らないかもしれない」ほうが、
    「何も選べない」よりまし。
    """
    cards = parse_cards(pactl("list", "cards"))

    def collect(skip_unavailable):
        out = []
        for c in cards:
            # 試験用の Dummy は出さない。CONFIG_SND_DUMMY=y のせいで
            # 実機にもカード 0 として出てきて、選ぶと黙って無音になる。
            # udev の PULSE_IGNORE でも隠しているが、そちらが効かない
            # 機械でも並ばないようにしておく。
            if "snd_dummy" in c["name"] or c["desc"].startswith("Dummy"):
                continue
            for p in c["ports"]:
                outp = output_profiles(p["profiles"])
                if not outp:
                    continue
                if skip_unavailable and p["avail"] == "no":
                    continue
                # 動いているプロファイルは足し算で書かれる。
                #   Active Profile: output:analog-stereo+input:analog-stereo
                # 丸ごと比べると、出ている出口まで「使われていない」に
                # なる。分解して、どれか 1 つでも一致すればよい。
                active = bool(set(c["active"].split("+")) & set(p["profiles"]))
                out.append({
                    "id": f"{c['name']}/{p['name']}",
                    "card": c["name"],
                    "port": p["name"],
                    "profile": c["active"] if active else outp[0],
                    "label": f"{c['desc'] or c['name']} - {p['desc']}",
                    "avail": p["avail"],
                    "active": active,
                })
        return out

    if all_ports:
        return collect(False)
    got = collect(True)
    return got if got else collect(False)


def default_sink():
    return (pactl("get-default-sink") or "").strip()


def sink_for(card_name, port_name=None):
    """その出口を持っている sink の名前。無ければ None。

    **ここが長いこと壊れていた。**

    元は `pactl list sinks` の中から "Card:" の行を探して、カードの
    番号と突き合わせていた。ところが pactl は **sink の情報にカードの
    番号を出さない**。実物 (pulseaudio-utils 16.1) の書式文字列を
    読んで確かめた。sink に出るのはこれだけ:

      Sink #%u / State / Name / Description / Driver /
      Sample Specification / Channel Map / Owner Module / Mute /
      Volume / Base Volume / Monitor Source / Latency / Flags /
      Properties / Ports / Active Port / Formats

    "Card:" はどこにも無い。つまりこの関数は **常に None を返して
    いた**。おかげで

      - Sound タブで出口を選ぶと必ず
        「出口はできましたが sink が見つかりません」で失敗し、
        選択が元に戻る (画面には Could not switch to that output.)
      - myos-audio list の「いま使っている」印が全部 - のまま

    という状態だった。実機で HDMI に切り替えられなかったのはこれ。

    ポート名で引く。欲しいのは「この出口を持っている sink」そのもの
    なので、カードを経由せずポートで探すのが一番短い。
    """
    text = pactl("list", "sinks")
    name = None
    in_ports = False

    if port_name:
        for raw in text.splitlines():
            line = raw.strip()
            if raw.startswith("Sink #"):
                name = None
                in_ports = False
                continue
            if line.startswith("Name:"):
                name = line.split(":", 1)[1].strip()
                continue
            if line == "Ports:":
                in_ports = True
                continue
            if in_ports:
                # Ports: の並びは次の見出しで終わる。
                if line.startswith(("Active Port:", "Formats:", "Properties:")):
                    in_ports = False
                    continue
                # 例: hdmi-output-0: HDMI / DisplayPort
                #       (type: HDMI, priority: 5900, available)
                m = re.match(r"^([A-Za-z0-9_.:+-]+): ", line)
                if m and name and m.group(1) == port_name:
                    return name

    # ポートで見つからないとき (プロファイルを切り替えた直後など) は
    # 名前の作りから当てる。PulseAudio は同じ機器を
    #   カード  alsa_card.pci-0000_00_03.0
    #   sink    alsa_output.pci-0000_00_03.0.hdmi-stereo
    # と名付けるので、頭を差し替えれば対応が取れる。
    if card_name.startswith("alsa_card."):
        want = "alsa_output." + card_name[len("alsa_card."):] + "."
        for raw in text.splitlines():
            line = raw.strip()
            if line.startswith("Name:"):
                n = line.split(":", 1)[1].strip()
                if n.startswith(want):
                    return n
    return None


def cmd_list(all_ports=False):
    cur = default_sink()
    for o in outputs(all_ports):
        sink = sink_for(o["card"], o["port"])
        mark = "*" if (o["active"] and sink and sink == cur) else "-"
        print(f"{mark}\t{o['id']}\t{o['label']}\t{o['avail']}")


def cmd_set(target):
    o = next((x for x in outputs() if x["id"] == target), None)
    if o is None:
        print(f"myos-audio: そんな出口はありません: {target}", file=sys.stderr)
        return 1

    # プロファイルが違うなら先に切り替える。HDMI は off のことが多く、
    # そのままでは sink すら無い。
    if not o["active"]:
        if pactl("set-card-profile", o["card"], o["profile"], check=True) is None:
            print("myos-audio: プロファイルを切り替えられません "
                  f"({o['card']} {o['profile']})", file=sys.stderr)
            return 1
        # sink が生えるまで少し待つ。すぐには出てこない。
        for _ in range(20):
            if sink_for(o["card"], o["port"]):
                break
            time.sleep(0.1)

    sink = sink_for(o["card"], o["port"])
    if not sink:
        print("myos-audio: 出口はできましたが sink が見つかりません",
              file=sys.stderr)
        return 1

    pactl("set-sink-port", sink, o["port"])
    pactl("set-default-sink", sink)

    # いま鳴っているものを連れて行く。既定を変えただけでは移らない。
    # ここをやらないと「切り替えたのに音が変わらない」になる。
    for line in (pactl("list", "short", "sink-inputs") or "").splitlines():
        f = line.split()
        if f:
            pactl("move-sink-input", f[0], sink)

    # 次に起動したときも同じ出口を使えるように控える。
    # ここを残さないと、再起動のたびに pulseaudio の判断へ戻ってしまい、
    # 「選んだのに毎回元に戻る」になる。
    try:
        conf = os.path.join(os.path.expanduser("~"), ".myos")
        os.makedirs(conf, exist_ok=True)
        with open(os.path.join(conf, "audio.conf"), "w") as f:
            f.write("# myOS: 音の出口。設定の Sound タブが書く。\n")
            f.write(f"output = {o['id']}\n")
    except OSError:
        pass                      # 控えられなくても、今の切り替えは効いている

    print(f"myos-audio: {o['label']}")
    return 0


def main():
    if len(sys.argv) < 2:
        print("使い方: myos-audio list | set <id>", file=sys.stderr)
        return 2
    if sys.argv[1] == "list":
        cmd_list("--all" in sys.argv); return 0
    if sys.argv[1] == "set" and len(sys.argv) > 2:
        return cmd_set(sys.argv[2])
    print("使い方: myos-audio list [--all] | set <id>", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
