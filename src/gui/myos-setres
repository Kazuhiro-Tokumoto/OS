#!/usr/bin/env python3
# ============================================================================
# myos-setres  -  次に起動するときの画面の解像度を決める
#
#   myos-setres            … いまの設定を表示する
#   myos-setres 1024 768   … 次回起動時の希望を書き込む
#   myos-setres auto       … おまかせに戻す
#
# 解像度は X からは変えられない。ブートローダーが VBE で決めた
# フレームバッファをそのまま使い続ける作り (nomodeset) だから。
# なので「次に起動するときの希望」をディスクに書いておく。
# 反映には再起動が要る。Windows 98 も色深度の変更に再起動が要った。
#
# 書き込む先は、ブートローダーが起動のたびに読むペイロードテーブル
# (ディスクの LBA 20)。その末尾に幅・高さ・色深度の欄がある。
# 要 root。
# ============================================================================
import os
import re
import struct
import sys

SECTOR = 512
PTBL_LBA = 20
MAGIC = b"MYOSPLD2"
OFF_W, OFF_H, OFF_BPP = 0x1F0, 0x1F2, 0x1F4

# 出せる見込みのあるものだけ並べる。VBE の標準的なモード。
CHOICES = [(640, 480), (800, 600), (1024, 768), (1152, 864),
           (1280, 720), (1280, 1024), (1440, 900), (1600, 900),
           (1680, 1050), (1920, 1080)]


def die(msg):
    print(f"myos-setres: {msg}", file=sys.stderr)
    sys.exit(1)


def boot_disk():
    """ルートが載っているディスク (パーティションではない) を返す。

    /proc/mounts に出てくる名前は当てにできない。カーネルが root= で
    そのままマウントすると **/dev/root** という、実体のファイルが無い
    名前が出る。実機で踏んだ:

        myos-setres: /dev/root がありません

    なので名前ではなく **デバイス番号** から引く。ルートの st_dev を
    major:minor に分けて /sys/dev/block から辿れば、名前が何であろうと
    実物に行き着く。sda2 でも nvme0n1p2 でも mmcblk0p1 でも同じ道。
    """
    st = os.stat("/")
    maj, mnr = os.major(st.st_dev), os.minor(st.st_dev)
    link = f"/sys/dev/block/{maj}:{mnr}"
    if not os.path.exists(link):
        die("ルートのデバイスが分かりません "
            f"(major {maj}, minor {mnr})")

    # 例: /sys/devices/.../block/sda/sda2  (パーティション)
    #     /sys/devices/.../block/sda       (ディスクそのもの)
    real = os.path.realpath(link)
    name = os.path.basename(real)
    parent = os.path.basename(os.path.dirname(real))
    # 親が /sys/block に居るならパーティション。居ないなら自分がディスク。
    disk = parent if os.path.exists(f"/sys/block/{parent}") else name

    path = f"/dev/{disk}"
    if not os.path.exists(path):
        die(f"{path} がありません")
    return path


def read_table(disk):
    with open(disk, "rb") as f:
        f.seek(PTBL_LBA * SECTOR)
        tbl = bytearray(f.read(SECTOR))
    if bytes(tbl[:8]) != MAGIC:
        die("ペイロードテーブルが見つかりません "
            "(このディスクから起動していない可能性があります)")
    return tbl


def show(tbl):
    w = struct.unpack_from("<H", tbl, OFF_W)[0]
    h = struct.unpack_from("<H", tbl, OFF_H)[0]
    b = tbl[OFF_BPP]
    if w == 0:
        print("current: auto")
    else:
        print(f"current: {w}x{h}" + (f" {b}bpp" if b else ""))


def main():
    args = sys.argv[1:]
    disk = boot_disk()
    tbl = read_table(disk)

    if not args:
        show(tbl)
        print("available:", ", ".join(f"{w}x{h}" for w, h in CHOICES))
        return

    if args[0] == "auto":
        w = h = b = 0
    else:
        if len(args) < 2:
            die("usage: myos-setres <width> <height> [bpp] | auto")
        try:
            w, h = int(args[0]), int(args[1])
            b = int(args[2]) if len(args) > 2 else 32
        except ValueError:
            die("数字で指定してください")
        if w <= 0 or h <= 0 or w > 4096 or h > 4096:
            die("その解像度は扱えません")
        if b not in (24, 32):
            die("色深度は 24 か 32 です")

    struct.pack_into("<HHB", tbl, OFF_W, w, h, b)

    # 書き換えるのはこのセクタだけ。カーネルの位置やコマンドラインは
    # 同じセクタに入っているので、読んだものをそのまま書き戻す。
    with open(disk, "r+b") as f:
        f.seek(PTBL_LBA * SECTOR)
        f.write(bytes(tbl))
        f.flush()
        os.fsync(f.fileno())

    # 読み返して確かめる。次の起動で初めて分かるのでは遅い。
    back = read_table(disk)
    if back[OFF_W:OFF_BPP + 1] != tbl[OFF_W:OFF_BPP + 1]:
        die("書き込みを確認できませんでした")

    # 選んだ値を誰でも読める形でも残す。
    #
    # ペイロードテーブルが本物で、起動時にそれを読むのはブートローダー。
    # だが**読むのに root が要る**。生のディスクを開くので当然で、
    # 一般ユーザーで動く設定の画面はここを覗けない。
    #
    # そのせいで設定の Display は「Currently set to: auto」しか出せず、
    # 選び直した直後もラジオが「おまかせ」に戻っていた。選んだのに
    # 選んだことになっていない画面は、使う人には壊れて見える。
    #
    # 読むためだけに root を要求する (毎回パスワードを聞く) のは筋が
    # 悪いので、控えを 1 行置く。判断には使わない。本物はテーブル。
    try:
        os.makedirs("/etc/myos", exist_ok=True)
        with open("/etc/myos/display.conf", "w") as f:
            f.write("# myOS: 次に起動するときの画面の大きさ。"
                    "myos-setres が書く。\n")
            f.write("# 本物はペイロードテーブル。これは表示用の控え。\n")
            f.write("mode = %s\n" % ("auto" if w == 0 else f"{w}x{h}"))
    except OSError:
        pass                      # 控えられなくても、書き込み自体は済んでいる

    show(back)
    print("takes effect after a restart.")


if __name__ == "__main__":
    main()
