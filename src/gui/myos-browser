#!/bin/sh
# ============================================================================
# myos-browser  -  入っている閲覧ソフトへ渡す
#
# 1.5.2 から、閲覧ソフトはインストールディスクに入れず、あとから
# 「プログラムの追加と削除」で入れる形にした。ISO が 84MiB 小さくなり、
# 機械に合ったものを選べる (1GB の機械に Firefox は重い)。
#
# その結果、デスクトップの「Internet」アイコンは
# 「まだ何も入っていない」状態がありうる。押して何も起きないのが
# いちばん困るので、そのときは選ぶ画面を出す。
#
# 探す順は「重いが確実」から。入っているものを使うだけで、優劣ではない。
# ============================================================================
for b in firefox-esr firefox epiphany-browser netsurf-gtk chromium; do
    if command -v "$b" >/dev/null 2>&1; then
        exec "$b" "$@"
    fi
done

# 1 つも無い。選ばせる。
exec /usr/local/bin/myos-getapps --need-browser
