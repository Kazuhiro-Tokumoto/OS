#!/usr/bin/env python3
# ============================================================================
# myos-writeboot  -  インストール先のディスクに起動の仕掛けを書く
#
#   myos-writeboot <ディスク> <ルートのパーティション> <生領域の開始LBA>
#                  [ファームウェアの initramfs]
#   例: myos-writeboot /dev/sda /dev/sda2 2048 /tmp/myos-fw.cpio.gz
#
# 書くもの (build_image.py が作るディスクイメージと同じ並び):
#   LBA 0        Stage1。パーティションテーブルだけは元のまま残す
#   LBA 1-17     Stage2
#   LBA 20       ペイロードテーブル (いま起動に使うもの)
#   LBA 21       その 1 つ前の控え (R を押すとこちらで起動する)
#   生領域       カーネルの setup 部と本体、そのうしろに initramfs
#
# 生領域は 256MB あるのに、使っているのは 57MB ほど。半分ずつに区切って
# 2 つの置き場として使う。カーネルを入れ替えるときは、いま使っていない
# ほうへ書いてから、テーブル (1 セクタ) を差し替える。書いている途中で
# 電源が落ちても、差し替える前なら古いほうがそのまま生きている。
#
# 元ネタは起動メディアの中身をそのまま使う。
#   /run/myos/boot/boot.img     Stage1 + Stage2
#   /run/myos/boot/payload.bin  ペイロードテーブル + カーネル + initramfs
#
# initramfs には GPU のファームウェアだけが入っている (myos-mkfwinit)。
# .ko を全て =y にしてあるので PCI の probe はルートのマウントより 1.1 秒
# 早く走る。そのときに /lib/firmware が無いと amdgpu も radeon も転ぶ。
# initramfs は rootfs_initcall で展開されるので probe に間に合う。
#
# 中に /init は置かない。カーネルは /init が無ければ initramfs の中身を
# 残したまま prepare_namespace() に進み、いつもどおり root= を
# マウントする (init/main.c の init_eaccess 判定)。起動の道筋は
# 今までと同じままで、ファームだけが先回りして置かれることになる。
# ============================================================================
import hashlib
import os
import re
import struct
import subprocess
import sys

SECTOR = 512
ALIGN = 4                       # 2048 バイト境界 (CD と同じ揃え方)

PTBL_MAGIC = b"MYOSPLD2"
PTBL_LBA = 20
# 1 つ前のテーブルの控え。カーネルを入れ替えるとき、書き換える直前の
# ものをここへ写す。Stage2 は起動中に R が押されていたらこちらを読む。
#
# 危ないのは「書き込みの中断」より「新しいカーネルがその機械で動かない」
# ほう。前者はテーブルが 1 セクタなので実質書けるか書けないかのどちらかで
# 済むが、後者は起動しなくなって手が出せなくなる。だから戻り道を用意する。
PTBL_BACKUP_LBA = 21
CMDLINE_OFF = 0x28              # Stage2 の PT_CMDLINE と同じ値
# コマンドラインの終わりは 0x1F0 まで。
# セクタ末尾 (0x1F0-) には画面の希望と媒体の印を置いてあるので、
# そこまで伸ばせるようにしておくと長いコマンドラインで踏み潰す。
CMDLINE_MAX = 0x1F0 - CMDLINE_OFF

MEDIUM = "/run/myos"
BOOT_IMG = f"{MEDIUM}/boot/boot.img"
PAYLOAD = f"{MEDIUM}/boot/payload.bin"

STAGE2_LBA = 1
STAGE2_SECTORS = 17
PART_TABLE_OFF = 0x1BE          # ここから先は元のまま残す


def die(msg):
    print(f"myos-writeboot: {msg}", file=sys.stderr)
    sys.exit(1)


def nsect(n):
    return (n + SECTOR - 1) // SECTOR


def align_up(lba):
    return (lba + ALIGN - 1) // ALIGN * ALIGN


def boot_area_sectors(disk, boot_lba):
    """生領域として使うパーティションのセクタ数を MBR から読む。
    見つからなければ 0 を返す (その場合は検査しない)。"""
    try:
        with open(disk, "rb") as f:
            mbr = f.read(SECTOR)
    except OSError:
        return 0
    if len(mbr) < SECTOR or mbr[510:512] != b"\x55\xAA":
        return 0
    for i in range(4):
        e = mbr[PART_TABLE_OFF + i * 16:PART_TABLE_OFF + (i + 1) * 16]
        if not e[4]:
            continue
        start, count = struct.unpack_from("<II", e, 8)
        if start == boot_lba:
            return count
    return 0


def split_bzimage(data):
    """bzImage を setup 部と本体に分ける。build_iso.py と同じ切り方。"""
    if data[0x202:0x206] != b"HdrS":
        die("bzImage に 'HdrS' がありません")
    setup_sects = data[0x1F1] or 4
    n = (setup_sects + 1) * SECTOR
    return data[:n], data[n:]


def read_table(disk, lba):
    """ディスク上のペイロードテーブルを 1 枚読む。目印が違えば None。"""
    try:
        with open(disk, "rb") as f:
            f.seek(lba * SECTOR)
            t = f.read(SECTOR)
    except OSError:
        return None
    return t if len(t) == SECTOR and t[:8] == PTBL_MAGIC else None


def kernel_sha(disk, lba=PTBL_LBA):
    """テーブルが指しているカーネルを読み直して sha256 を返す。

    「入れたときの値」を控えておくのではなく、そのつど生領域の実物を
    読んで数える。控えは書き換え忘れや書き損じで実物とずれるが、
    ずれた控えを信じると「入れ替えたのに入れ替わっていない」を
    見落とす。読み直せばずれようが無い。

    setup 部は必ずセクタ丁度に収まり、本体はバイト数がテーブルに
    入っているので、繋げると元の bzImage と 1 バイトも違わない。
    """
    t = read_table(disk, lba)
    if t is None:
        return None
    ks_lba, ks_cnt, kb_lba, _kb_cnt, b_size = struct.unpack_from(
        "<IIIII", t, 0x08)
    if not ks_cnt or not b_size:
        return None
    h = hashlib.sha256()
    try:
        with open(disk, "rb") as f:
            f.seek(ks_lba * SECTOR)
            d = f.read(ks_cnt * SECTOR)
            if len(d) != ks_cnt * SECTOR:
                return None
            h.update(d)
            f.seek(kb_lba * SECTOR)
            d = f.read(b_size)
            if len(d) != b_size:
                return None
            h.update(d)
    except OSError:
        return None
    return h.hexdigest()


def pick_slot(disk, boot_lba, area):
    """次に書く置き場の開始 LBA を返す。

    生領域を半分ずつ 2 つに区切り、いま使っていないほうを返す。
    まだ何も入っていなければ前半。

    area が読めなかった (0) ときは区切りようがないので前半に書く。
    上書きになるが、それは今までと同じ動きなので後退はしない。
    """
    first = align_up(boot_lba)
    if not area:
        return first, first
    mid = align_up(boot_lba + area // 2)

    cur = read_table(disk, PTBL_LBA)
    if cur is None:
        return first, mid
    s_lba = struct.unpack_from("<I", cur, 0x08)[0]
    # いま前半を使っているなら後半へ、後半なら前半へ。
    return (mid, first) if s_lba < mid else (first, mid)


def main():
    argv = sys.argv[1:]
    kernel_path = None
    initrd_path = None
    keep_cmdline = False
    want_sha = False
    switch_root = None
    safe_gfx = None
    want_info = False
    dump_kernel = None
    cmd_add = []
    cmd_del = []

    # --kernel を渡すと、起動メディアではなくその bzImage を書く。
    # インストール後にカーネルだけ入れ替えるための口。
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--kernel" and i + 1 < len(argv):
            kernel_path = argv[i + 1]; i += 2
        elif a == "--initrd" and i + 1 < len(argv):
            initrd_path = argv[i + 1]; i += 2
        elif a == "--keep-cmdline":
            keep_cmdline = True; i += 1
        elif a == "--kernel-sha":
            want_sha = True; i += 1
        elif a == "--info":
            want_info = True; i += 1
        elif a == "--dump-kernel" and i + 1 < len(argv):
            dump_kernel = argv[i + 1]; i += 2
        elif a == "--switch-root" and i + 1 < len(argv):
            switch_root = argv[i + 1]; i += 2
        elif a == "--safe-graphics" and i + 1 < len(argv):
            safe_gfx = argv[i + 1]; i += 2
        elif a == "--cmdline-add" and i + 1 < len(argv):
            cmd_add.append(argv[i + 1]); i += 2
        elif a == "--cmdline-del" and i + 1 < len(argv):
            cmd_del.append(argv[i + 1]); i += 2
        else:
            rest.append(a); i += 1

    # いま起動に使っているカーネルの sha256 を出すだけの口。
    # myos-update が「落としてくる価値があるか」を決めるのに使う。
    # ここに置くのは、テーブルの並びを知っているのがこのファイルだから。
    # 同じ struct を 2 か所に書くと、片方だけ直したときに黙って壊れる。
    if want_sha:
        if not rest:
            die("usage: myos-writeboot --kernel-sha <disk>")
        h = kernel_sha(rest[0])
        if h is None:
            die("ペイロードテーブルを読めません")
        print(h)
        return

    # いま起動しているカーネルを、生領域から取り出してファイルに戻す口。
    #
    # 「カーネルはそのままで initramfs だけ入れ直したい」ときに要る。
    # 入れ直しの道は --kernel を渡す 1 本しか無く、そこへ渡す bzImage が
    # 手元に無いことがある (入れたときの ISO はもう無い)。生領域には
    # 1 バイトも欠けずに入っているので、そこから戻せばよい。
    # 切り方は kernel_sha() と同じ。setup 部はセクタ丁度、本体は
    # バイト数がテーブルに入っている。
    if dump_kernel:
        if not rest:
            die("usage: myos-writeboot --dump-kernel <out> <disk>")
        t = read_table(rest[0], PTBL_LBA)
        if t is None:
            die("ペイロードテーブルを読めません")
        ks_lba, ks_cnt, kb_lba, _kb_cnt, b_size = struct.unpack_from(
            "<IIIII", t, 0x08)
        if not ks_cnt or not b_size:
            die("カーネルの場所が入っていません")
        with open(rest[0], "rb") as f:
            f.seek(ks_lba * SECTOR)
            setup = f.read(ks_cnt * SECTOR)
            f.seek(kb_lba * SECTOR)
            body = f.read(b_size)
        if len(setup) != ks_cnt * SECTOR or len(body) != b_size:
            die("生領域を読み切れません")
        if setup[0x202:0x206] != b"HdrS":
            die("取り出したものが bzImage に見えません")
        with open(dump_kernel, "wb") as f:
            f.write(setup)
            f.write(body)
        print(f"myos-writeboot: ok  {dump_kernel}  "
              f"{(len(setup) + len(body)) // 1048576} MB")
        return

    # いま何が書いてあるかを、そのまま読んで出す口。
    #
    # 「入れたはずのものが入っていない」を疑ったときに、実機で確かめる
    # 手立てが無かった。dd と od でバイトを数えるしかなく、それでは
    # 誰も見ない。ここに出しておけば 1 行で分かる。
    # 特に initramfs の欄が 0 かどうかは大事で、0 なら
    # 「入れるときに作れなかった」、0 でないのに読めていないなら
    # 「起動のときに読めていない」と、切り分けが 1 発で付く。
    if want_info:
        if not rest:
            die("usage: myos-writeboot --info <disk>")
        for name, lba in (("いま使うテーブル", PTBL_LBA),
                          ("控え (R で戻る)", PTBL_BACKUP_LBA)):
            t = read_table(rest[0], lba)
            print(f"--- {name}  (LBA {lba})")
            if t is None:
                print("    ありません")
                continue
            (ks_lba, ks_cnt, kb_lba, kb_cnt, kb_size,
             i_lba, i_cnt, i_size) = struct.unpack_from("<IIIIIIII", t, 0x08)
            cmd = bytes(t[CMDLINE_OFF:0x1F0]).split(b"\x00")[0]
            print(f"    kernel setup : LBA {ks_lba}  {ks_cnt} sect")
            print(f"    kernel body  : LBA {kb_lba}  {kb_cnt} sect  "
                  f"{kb_size} bytes ({kb_size // 1048576} MB)")
            if i_size:
                print(f"    initramfs    : LBA {i_lba}  {i_cnt} sect  "
                      f"{i_size} bytes ({i_size // 1048576} MB)")
            else:
                print("    initramfs    : ありません  "
                      "<- GPU のファームウェアが 1 つも積まれていない")
            print(f"    cmdline      : {cmd.decode('ascii', 'replace')}")
        return

    # ルートだけ差し替える口。カーネルの塊には一切触らない。
    #
    # ルートを A/B で持つと、更新は「使っていないほうへ新しい中身を
    # 展開して、起動するルートを切り替える」だけになる。切り替えの実体は
    # コマンドラインの root= を書き換えることで、テーブル 1 セクタの
    # 書き込みで済む。
    #
    # 控えは今までどおり LBA 21 へ写す。だから **起動中に R を押せば
    # 古いテーブルで立ち、古いルートに戻る**。カーネルのために作った
    # 戻り道が、そのままルートにも効く。新しい仕掛けは要らない。
    if switch_root or safe_gfx or cmd_add or cmd_del:
        if not rest:
            die("usage: myos-writeboot --switch-root <rootdev> <disk>\n"
                "       myos-writeboot --safe-graphics on|off <disk>\n"
                "       myos-writeboot --cmdline-add <word> "
                "[--cmdline-del <word>] <disk>")
        disk = rest[0]
        cur = read_table(disk, PTBL_LBA)
        if cur is None:
            die("ペイロードテーブルを読めません")

        prev = bytes(cur[CMDLINE_OFF:0x1F0]).split(b"\x00")[0]
        line = prev.decode("ascii", "replace")

        if switch_root:
            if "root=" not in line:
                die(f"いまのコマンドラインに root= がありません: {line!r}")
            new_line = re.sub(r"root=\S+", f"root={switch_root}", line)
            what = (f"root {line.split('root=')[1].split()[0]} "
                    f"-> {switch_root}")
        elif safe_gfx:
            # セーフグラフィックスを覚えさせる。
            #
            # 起動中に S を押せば同じことができるが、**画面が出ない機械
            # では毎回押すことになる**。それは使い物にならない。
            # コマンドラインに書いておけば、次からは押さなくていい。
            if safe_gfx not in ("on", "off"):
                die("usage: myos-writeboot --safe-graphics on|off <disk>")
            words = [w for w in line.split() if w != "nomodeset"]
            if safe_gfx == "on":
                words.append("nomodeset")
            new_line = " ".join(words)
            what = f"safe graphics -> {safe_gfx}"
        else:
            # コマンドラインの語を足し引きする汎用の口。
            #
            # NVIDIA の公式ドライバを入れたときに nouveau.modeset=0 を
            # 足すのに要る。nouveau は =y なので modprobe.blacklist が
            # 効かず、これしか止める手が無い。
            #
            # 名前が同じで値が違う語 (foo=1 と foo=0) は 1 つにまとめる。
            # 足し引きを繰り返しても増えないようにするため。
            def key_of(w):
                return w.split("=", 1)[0]
            drop = set()
            for w in cmd_del:
                drop.add(key_of(w))
            for w in cmd_add:
                drop.add(key_of(w))
            words = [w for w in line.split() if key_of(w) not in drop]
            words.extend(cmd_add)
            new_line = " ".join(words)
            bits = []
            if cmd_add:
                bits.append("+" + " +".join(cmd_add))
            if cmd_del:
                bits.append("-" + " -".join(cmd_del))
            what = "cmdline " + " ".join(bits)

        cmd = new_line.encode("ascii", "replace")
        if len(cmd) >= CMDLINE_MAX:
            die("コマンドラインが長すぎます")

        tbl = bytearray(cur)
        # 前の内容を消してから書く。短くなったとき、古い文字列の尻尾が
        # 残って別のコマンドラインになってしまう。
        for k in range(CMDLINE_OFF, 0x1F0):
            tbl[k] = 0
        tbl[CMDLINE_OFF:CMDLINE_OFF + len(cmd)] = cmd

        with open(disk, "r+b") as f:
            # 先に控え。ここで落ちても、まだ差し替えていないので
            # 次の起動は今までどおり。
            f.seek(PTBL_BACKUP_LBA * SECTOR)
            f.write(bytes(cur))
            f.flush(); os.fsync(f.fileno())
            f.seek(PTBL_LBA * SECTOR)
            f.write(bytes(tbl))
            f.flush(); os.fsync(f.fileno())

        got = read_table(disk, PTBL_LBA)
        if got is None or bytes(got[CMDLINE_OFF:0x1F0]).split(b"\x00")[0] != cmd:
            die("書き込みを確認できませんでした")
        print(f"myos-writeboot: ok  {what}  (控えは LBA {PTBL_BACKUP_LBA})")
        return

    if len(rest) < 3:
        die("usage: myos-writeboot [--kernel <bzImage>] [--initrd <file>] "
            "[--keep-cmdline] <disk> <rootdev> <boot_area_lba> [initrd]")
    disk, rootdev, boot_lba = rest[0], rest[1], int(rest[2])
    if initrd_path is None and len(rest) > 3:
        initrd_path = rest[3]

    initrd = b""
    if initrd_path:
        if not os.path.exists(initrd_path):
            die(f"{initrd_path} がありません")
        initrd = open(initrd_path, "rb").read()

    if kernel_path:
        # カーネルだけ入れ替える。Stage1 と Stage2 は今のものをそのまま
        # 使う (ディスクに既に入っている)。触らないほうが安全でもある。
        if not os.path.exists(kernel_path):
            die(f"{kernel_path} がありません")
        k_setup, k_body = split_bzimage(open(kernel_path, "rb").read())
        stage1 = stage2 = None
    else:
        for p in (BOOT_IMG, PAYLOAD):
            if not os.path.exists(p):
                die(f"{p} がありません (起動メディアが見えていない)")

        boot = open(BOOT_IMG, "rb").read()
        if len(boot) < (1 + STAGE2_SECTORS) * SECTOR:
            die("boot.img が小さすぎます")
        stage1 = bytearray(boot[:SECTOR])
        stage2 = boot[SECTOR:(1 + STAGE2_SECTORS) * SECTOR]

        # 起動メディアのペイロードから、カーネルの setup 部と本体を取り出す。
        pay = open(PAYLOAD, "rb").read()
        if pay[:8] != PTBL_MAGIC:
            die("payload.bin の目印が違います")
        s_lba, s_cnt, b_lba, b_cnt, b_size = struct.unpack_from(
            "<IIIII", pay, 0x08)

        # ペイロード内の位置は CD 上の絶対 LBA になっている。
        # 先頭 (テーブル) の LBA を引いて、ファイル内の位置に直す。
        base = s_lba - align_up(1)
        k_setup = pay[(s_lba - base) * SECTOR:(s_lba - base + s_cnt) * SECTOR]
        k_body = pay[(b_lba - base) * SECTOR:(b_lba - base) * SECTOR + b_size]
        if k_setup[0x202:0x206] != b"HdrS":
            die("カーネルの 'HdrS' が見つかりません")

    # --- 置き場所を決める ---------------------------------------------------
    # 生領域を半分ずつ 2 つに区切り、いま使っていないほうへ書く。
    # 書き終えてからテーブルを差し替えるので、途中で電源が落ちても
    # 古いほうがそのまま生きている。
    area = boot_area_sectors(disk, boot_lba)
    slot, other = pick_slot(disk, boot_lba, area)

    lba = slot
    ks_lba, ks_cnt = lba, nsect(len(k_setup))
    lba = align_up(lba + ks_cnt)
    kb_lba, kb_cnt = lba, nsect(len(k_body))
    lba = align_up(lba + kb_cnt)
    if initrd:
        i_lba, i_cnt = lba, nsect(len(initrd))
        lba = align_up(lba + i_cnt)
    else:
        i_lba, i_cnt = 0, 0

    # 生領域の大きさは決め打ちにせず、パーティションテーブルから読む。
    # 決め打ちにすると、あとで容量を変えたときに片方だけ直して食い違う。
    # (古い 128MB の入れ方に上書きする場合もあるので、実物を見るのが確実)
    #
    # 収まるかどうかは「この置き場の終わり」で見る。前半に書いたものが
    # 後半へはみ出すと、次に入れ替えるとき自分で自分を壊すことになる。
    if area:
        limit = align_up(boot_lba + area) if slot != align_up(boot_lba) \
                else align_up(boot_lba + area // 2)
        if area // 2 < nsect(len(k_setup)) + nsect(len(k_body)) + \
                       nsect(len(initrd)) + 3 * ALIGN:
            # 2 つに割ると入らない大きさ。割らずに前半だけ使う
            # (入れ替えは上書きになるが、入らないよりよい)。
            limit = align_up(boot_lba + area)
        if lba > limit:
            die(f"生領域の置き場 {(limit - slot) * SECTOR // 1048576}MB に"
                f"収まりません ({(lba - slot) * SECTOR // 1048576}MB 必要)")

    # Stage2 は initramfs を 0x08000000 (128MB) へ読み込む。カーネルが
    # 展開に使う領域 (setup ヘッダの init_size) とぶつかると、伸ばした
    # そばから踏み潰されて起動に失敗する。
    init_size = struct.unpack_from("<I", k_setup, 0x260)[0]
    if initrd and 0x100000 + init_size > 0x08000000:
        die(f"カーネルの展開領域 ({init_size // 1048576}MB) が "
            f"initramfs の置き場 (128MB) に届いています")

    # nomodeset は使わない。あれは KMS を丸ごと切るので、実機に GPU が
    # あっても使われず、描画が全て CPU に落ちる (3D は実用にならない)。
    #
    # 画面が真っ黒になる原因は vmwgfx だけなので、そこだけ止める。
    # 名前はビルド済みカーネルの System.map で確認したもの。
    # 組み込み (=y) なので modprobe.blacklist は効かない。initcall で外す。
    #
    #   実機        i915 / amdgpu / nouveau が動き GPU 支援が効く
    #   VirtualBox  vmwgfx が出てこないので simpledrm が画面を持つ
    # quiet と loglevel=3 を必ず付ける。既定の CONSOLE_LOGLEVEL_DEFAULT は
    # 7 なので、これが無いとカーネルのログが起動中ずっと流れ続ける。
    # 98 の起動画面に文字が滝のように出てくるのはおかしい。
    # 消えたログは dmesg で見られるし、init 側は BOOTLOG.TXT に残す。
    #
    # vt.global_cursor_default=0 はカーソルの点滅を止める。
    # X が上がるまでの数秒、左上でカーソルが点滅しているのが見えてしまう。
    cmdline = (f"console=tty0 quiet loglevel=3 vt.global_cursor_default=0 "
               f"initcall_blacklist=vmw_pci_driver_init "
               f"root={rootdev} rootfstype=ext4 rw "
               f"init=/myos-init")
    # カーネルだけ入れ替えるとき、いま動いているコマンドラインを
    # 引き継ぎたいことがある (解像度の希望や、手で足した設定が
    # 消えると困る)。--keep-cmdline でそうする。
    #
    # ただし root= だけは引数のほうを使う。
    #
    # 前は前のコマンドラインを丸ごと持ってきていて、**引数の rootdev を
    # 無視していた**。おかげでカーネルとルートを一度に入れ替えられず、
    #   1. --kernel --keep-cmdline でカーネルを書く
    #   2. --switch-root でルートを差し替える
    # と 2 回に分ける必要があった。2 回書くと、控え (LBA 21) に残るのは
    # 1 回目の途中の状態になり、R で戻ったときの行き先が中途半端になる。
    #
    # 「引き継ぐのは手で足した設定、root= は言われたとおり」にすれば、
    # カーネル・initramfs・ルートを **1 回の書き込み** で入れ替えられる。
    # カーネルだけ更新する場合は、呼ぶ側が今のルートを渡すので何も変わらない。
    old_tbl = read_table(disk, PTBL_LBA)
    if keep_cmdline and old_tbl:
        prev = bytes(old_tbl[CMDLINE_OFF:0x1F0]).split(b"\0")[0]
        if prev:
            kept = prev.decode("ascii", "replace")
            if "root=" in kept:
                kept = re.sub(r"root=\S+", f"root={rootdev}", kept)
            else:
                kept = f"{kept} root={rootdev}"
            cmdline = kept

    cmd = cmdline.encode("ascii", "replace")
    if len(cmd) >= CMDLINE_MAX:
        die("コマンドラインが長すぎます")

    tbl = bytearray(SECTOR)
    tbl[0:8] = PTBL_MAGIC
    # 並びは Stage2 の PT_* と 1 対 1。バイト数の欄も必ず埋めること。
    struct.pack_into("<IIIIIIII", tbl, 0x08,
                     ks_lba, ks_cnt,
                     kb_lba, kb_cnt, len(k_body),
                     i_lba, i_cnt, len(initrd))
    tbl[CMDLINE_OFF:CMDLINE_OFF + len(cmd)] = cmd

    # 画面の希望 (0x1F0-0x1F7)。新規なら 0 =「おまかせ」。
    # カーネルの入れ替えでは、いま入っているものを写す。ここを 0 に
    # 戻すと、設定アプリで選んだ解像度が入れ替えのたびに消える。
    if kernel_path and old_tbl:
        tbl[0x1F0:0x1F8] = old_tbl[0x1F0:0x1F8]

    # --- 書き込む -----------------------------------------------------------
    # 順番が肝心。
    #   1. カーネルと initramfs を「使っていないほうの置き場」へ書く
    #   2. そこまで書けたことを読み返して確かめる
    #   3. いまのテーブルを控えへ写す
    #   4. 最後にテーブルを差し替える (1 セクタ)
    # 3 より前で電源が落ちても、古いテーブルが古い置き場を指したまま
    # なので、次の起動は今までどおりになる。
    with open(disk, "r+b") as f:
        if stage1 is not None:
            # Stage1。パーティションテーブルは元のものを残す。
            # ここを丸ごと上書きすると、切ったばかりのパーティションが消える。
            f.seek(0)
            orig = f.read(SECTOR)
            stage1[PART_TABLE_OFF:SECTOR] = orig[PART_TABLE_OFF:SECTOR]
            f.seek(0)
            f.write(bytes(stage1))

            f.seek(STAGE2_LBA * SECTOR)
            f.write(stage2)

        f.seek(ks_lba * SECTOR)
        f.write(k_setup)

        f.seek(kb_lba * SECTOR)
        f.write(k_body)

        if initrd:
            f.seek(i_lba * SECTOR)
            f.write(initrd)

        f.flush()
        os.fsync(f.fileno())

    # 中身が確かに乗ったことを確かめてから、テーブルを差し替える。
    with open(disk, "rb") as f:
        f.seek(ks_lba * SECTOR + 0x202)
        if f.read(4) != b"HdrS":
            die("カーネルの書き込みを確認できません (テーブルは触っていない)")
        f.seek(kb_lba * SECTOR)
        if f.read(64) != k_body[:64]:
            die("カーネル本体の書き込みを確認できません (テーブルは触っていない)")
        if initrd:
            f.seek(i_lba * SECTOR)
            if f.read(64) != initrd[:64]:
                die("initramfs の書き込みを確認できません (テーブルは触っていない)")

    with open(disk, "r+b") as f:
        # いまのテーブルを控えへ。戻り道はこれ 1 本。
        if old_tbl:
            f.seek(PTBL_BACKUP_LBA * SECTOR)
            f.write(bytes(old_tbl))
            f.flush()
            os.fsync(f.fileno())

        f.seek(PTBL_LBA * SECTOR)
        f.write(bytes(tbl))
        f.flush()
        os.fsync(f.fileno())

    # 差し替えたものを読み返す。
    with open(disk, "rb") as f:
        if stage1 is not None:
            f.seek(0)
            if f.read(2) != bytes(stage1[:2]):
                die("Stage1 の書き込みを確認できません")
        f.seek(PTBL_LBA * SECTOR)
        t = f.read(SECTOR)
        if t[:8] != PTBL_MAGIC:
            die("ペイロードテーブルの書き込みを確認できません")
        if struct.unpack_from("<I", t, 0x08)[0] != ks_lba:
            die("ペイロードテーブルが新しい置き場を指していません")

    subprocess.run(["sync"], check=False)
    fw = f" initrd@{i_lba} ({len(initrd) // 1048576}MB)" if initrd else ""
    back = f" backup@{PTBL_BACKUP_LBA}" if old_tbl else ""
    # root= は引数ではなく **実際に書いたコマンドライン** から出す。
    # --keep-cmdline のときは引数のほうを使っていないので、引数を
    # そのまま出すと嘘になる。実機で
    #   root=/dev/sda5 で動いている機械に root=/dev/sda3 と表示され、
    #   「入れ替えが巻き戻された」と読める出方をした。
    m = re.search(r"root=(\S+)", cmdline)
    shown = m.group(1) if m else "(root= なし)"
    print(f"myos-writeboot: ok  table@{PTBL_LBA}{back} "
          f"slot@{slot} setup@{ks_lba} body@{kb_lba}{fw} root={shown}")


if __name__ == "__main__":
    main()
