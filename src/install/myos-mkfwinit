#!/bin/sh
# ============================================================================
# myos-mkfwinit  -  GPU のファームウェアだけを詰めた initramfs を作る
#
#   myos-mkfwinit <ルートのディレクトリ> <出力する cpio.gz>
#   例: myos-mkfwinit /mnt/target /tmp/myos-fw.cpio.gz
#
# なぜ要るか
# ----------
# 引き継ぎ資料の方針どおり .ko は全て =y にしてある。おかげでモジュールを
# 入れる手間は無いが、代わりに PCI の probe がルートのマウントより前に走る。
# 実測するとこうなる。
#
#   [    1.863217] calling  radeon_module_init  @ 1
#   [    1.863637] calling  amdgpu_init         @ 1
#   [    1.864744] calling  i915_init           @ 1
#   [    1.866443] calling  nouveau_drm_init    @ 1
#   [    2.993505] VFS: Cannot open root device
#
# 1.1 秒の差がある。この間 /lib/firmware は存在しないので、
# ファームを要るドライバは probe の時点で必ず失敗する。しかも radeon は
#
#   radeon_drv.c:300  drm_aperture_remove_conflicting_pci_framebuffers()
#   r600.c:3302       DRM_ERROR("Failed to load firmware!"); return r;
#
# の順で、VBE の画面を先に取り上げてから転ぶ。だから今までは
# HD 2000〜HD 7000 を挿した機械が真っ暗になっていた。
#
# initramfs は rootfs_initcall で展開されるので device_initcall より前。
# ここに /lib/firmware を置いておけば probe に間に合う。
#
# なぜ 1 個ずつ zstd で潰すか
# --------------------------
# cpio の中身は ramfs に「展開された状態」で載り、そのまま常駐する。
# 生のまま入れると 110MB のメモリが起動中ずっと死ぬ。1 つずつ潰しておけば
# 3 割で済み、カーネルは request_firmware() のときに name.zst を探して
# 自分で伸ばしてくれる (CONFIG_FW_LOADER_COMPRESS_ZSTD)。
#
# 入れるのは GPU の 4 つだけ。無線 LAN などはルートが見えてから読まれるので
# ここに入れる意味が無い。
# ============================================================================
set -e

# 入れるもの。ディレクトリ名か、firmware の直下に置くファイルの glob。
#
# GPU だけを入れる。ドライバは組み込み (=y) なので probe がルートの
# マウントより先に走り、ここに無いとファームを読めない。実測:
#
#   [    1.863217] calling  radeon_module_init  @ 1
#   [    2.993505] VFS: Cannot open root device
#
# 無線は入れない。同じ問題を抱えているが、こちらは起動後に
# sysfs で bind し直せば済む (myos-init の rebind_wifi)。画面と違って
# やり直しても誰も困らないので、90MB を initramfs に積む必要が無い。
# 実際に積んでみたら 36MB -> 92MB になり、ブートローダーが INT13h で
# 読む時間だけで 14 秒延びた。
#
# regulatory.db だけは例外で入れる。これは cfg80211 が自分の初期化で
# 一度だけ要求するもので、デバイスに紐づいていないため bind し直せない。
# 数 KB しかないので入れても増えない。署名付き
# (CFG80211_REQUIRE_SIGNED_REGDB=y) なので .p7s も一緒に。
FWSET="amdgpu radeon nvidia i915
       regulatory.db regulatory.db.p7s"

usage() { echo "usage: myos-mkfwinit <rootdir> <out.cpio.gz>" >&2; exit 2; }

[ $# -eq 2 ] || usage
SRCROOT="$1"
OUT="$2"

[ -d "$SRCROOT" ] || { echo "myos-mkfwinit: $SRCROOT がありません" >&2; exit 1; }
command -v zstd >/dev/null 2>&1 || \
    { echo "myos-mkfwinit: zstd がありません" >&2; exit 1; }
command -v cpio >/dev/null 2>&1 || \
    { echo "myos-mkfwinit: cpio がありません" >&2; exit 1; }

FWSRC="$SRCROOT/lib/firmware"
[ -d "$FWSRC" ] || FWSRC="$SRCROOT/usr/lib/firmware"
[ -d "$FWSRC" ] || { echo "myos-mkfwinit: firmware が見つかりません" >&2; exit 1; }

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/lib/firmware"

found=0
for pat in $FWSET; do
    # ディレクトリなら丸ごと、そうでなければ glob として展開する。
    # iwlwifi は firmware の直下に 55 個のファイルとして置かれていて、
    # ディレクトリになっていない。
    if [ -d "$FWSRC/$pat" ]; then
        cp -a "$FWSRC/$pat" "$WORK/lib/firmware/$pat"
        found=1
        continue
    fi
    for f in $FWSRC/$pat; do
        # -e だけで見ると取りこぼす。regulatory.db は
        #   regulatory.db -> /etc/alternatives/regulatory.db
        # という *絶対パス* のリンクで、別のルートを渡された場合
        # (インストーラは /mnt/target を渡す) 行き先がこちらのルートに
        # 無いので -e が偽になる。リンクそのものは有るので -L で拾い、
        # 実体はこの下の「木の外を指すリンク」の処理で連れてくる。
        [ -e "$f" ] || [ -L "$f" ] || continue
        cp -a "$f" "$WORK/lib/firmware/"
        found=1
    done
done
[ "$found" = 1 ] || { echo "myos-mkfwinit: 入れるものがありません" >&2; exit 1; }

# --- 木の外を指すリンクを実体に置き換える ---------------------------------
# ここが 1.5.x でずっと画面が真っ暗になっていた原因。
#
# Debian の wireless-regdb は /lib/firmware/regulatory.db を
#
#   regulatory.db      -> /etc/alternatives/regulatory.db
#   regulatory.db.p7s  -> /etc/alternatives/regulatory.db.p7s
#
# という *絶対パスで firmware の木の外* を指すリンクにしている
# (dpkg の alternatives)。initramfs の中に /etc/alternatives は無いので、
# このリンクは中で絶対に解決しない。下の「行き先の無いリンク」検査に
# 引っかかって myos-mkfwinit が exit 1 で落ちる。
#
# そしてインストーラは
#
#   int have_fw = (run(fwi) == 0) && access(FWINIT, R_OK) == 0;
#
# と書いてあり、失敗しても黙って先へ進む。結果、
# **initramfs が 1 つも入らないまま** 出来上がる。ファームを要る GPU
# (nouveau / radeon / amdgpu) は probe がルートのマウントより先に走るので、
# そこで転んで VGA コンソールを取り上げる。画面が真っ暗になる。
# 実機の dmesg がまさにこれだった:
#
#   nouveau 0000:01:00.0: acr: firmware unavailable
#   nouveau 0000:01:00.0: vgaarb: deactivate vga console
#   platform regulatory.0: Direct firmware load for regulatory.db failed
#   (787 行のどこにも "Unpacking initramfs" が無い)
#
# NVIDIA 固有の話ではない。regulatory.db 1 本のせいで全部の GPU の
# ファームウェアが丸ごと落ちていた。
#
# 直し方は「リンクを実体にする」。行き先はこちらのルート (SRCROOT) を
# 基準にして自分で辿る。alternatives はリンクのリンクになっているので
# (/etc/alternatives/regulatory.db -> /lib/firmware/regulatory.db-debian)、
# 一段ではなく最後まで辿る。cp -L に任せられないのは、絶対パスを
# *動いているこの機械の /* から見てしまうため。
resolve_in_root() {
    p="$1"; n=0
    while [ -L "$p" ] && [ "$n" -lt 40 ]; do
        t="$(readlink "$p")"
        case "$t" in
            /*) p="$SRCROOT$t" ;;       # 絶対パスは SRCROOT を根とみなす
            *)  p="$(dirname "$p")/$t" ;;
        esac
        n=$((n + 1))
    done
    printf '%s\n' "$p"
}

# パイプで while を回すとサブシェルになり、中の exit が効かない。
# 一覧をファイルに落としてから読む。
LINKS="$WORK/.links"
find "$WORK/lib/firmware" -type l > "$LINKS"
while IFS= read -r l; do
    t="$(readlink "$l")"
    case "$t" in
        /*)  ;;                         # 絶対 = 必ず木の外
        *)   # 相対。木の中に収まっているならそのままでよい。
             case "$(realpath -m "$(dirname "$l")/$t")" in
                 "$WORK"/lib/firmware/*) continue ;;
             esac
             ;;
    esac

    # 元の firmware の木の中での位置に戻して、そこから行き先を辿る。
    rel="${l#$WORK/lib/firmware/}"
    case "$t" in
        /*) src="$(resolve_in_root "$SRCROOT$t")" ;;
        *)  src="$(resolve_in_root "$(dirname "$FWSRC/$rel")/$t")" ;;
    esac

    if [ -f "$src" ]; then
        rm -f "$l"
        cp -a "$src" "$l"
    else
        # 拾えないものは黙って捨てる。ここで落とすと、たかが
        # regulatory.db 1 本で GPU のファームが全部無くなる
        # (それが今回の原因)。無いなら無いで、その 1 本が読めない
        # だけで済ませる。
        echo "myos-mkfwinit: $rel の行き先 ($t) を辿れないので外します" >&2
        rm -f "$l"
    fi
done < "$LINKS"
rm -f "$LINKS"

# --- 先にシンボリックリンクの行き先を .zst に付け替える -------------------
# i915/kbl_dmc_ver1.bin -> kbl_dmc_ver1_01.bin のような別名がある。
# 実体が .zst になるので、リンクもそちらを向かせる。
#
# 潰すより前にやるのが肝心。あとからだと
#   nvidia/gp104/gr/fecs_bl.bin -> ../../gp102/gr/fecs_bl.bin
# のようにリンクがリンクを指している場合に、行き先がまだ直っていない間は
# 「実体も .zst も無い」と見えてしまい、取りこぼす。
# 潰す前ならディレクトリかどうかを -d で確実に判定できる。
find "$WORK/lib/firmware" -type l | while IFS= read -r l; do
    t="$(readlink "$l")"
    d="$(dirname "$l")"
    # ディレクトリを指しているもの (nvidia/ga106/gsp -> ../ga102/gsp) は
    # 中身のファイル名を変えるわけではないので触らない。
    [ -d "$d/$t" ] && continue
    ln -sfn "$t.zst" "$l.zst"
    rm -f "$l"
done

# --- 1 ファイルずつ潰す ---------------------------------------------------
# コア数ぶん並べる。Core 2 Duo でも数十秒で終わる程度。
NPROC="$(nproc 2>/dev/null || echo 1)"
find "$WORK/lib/firmware" -type f -print0 |
    xargs -0 -r -P "$NPROC" -n 8 zstd -q --rm -19 2>/dev/null || \
find "$WORK/lib/firmware" -type f -print0 |
    xargs -0 -r -n 1 zstd -q --rm -19

# --- 取りこぼしが無いか確かめる -------------------------------------------
# 宙に浮いたリンクが残っていると、そのファームだけ読めない。
# 起動してから GPU が動かない理由を探すのは大変なので、ここで落とす。
# ここで exit 1 にしていたのが 1.5.x の事故だった。1 本でも宙に浮くと
# initramfs ごと作られず、GPU のファームウェアが全部消える。
# 宙に浮いたリンクは「そのファームだけ読めない」で済むのだから、
# それだけ外して残りは渡す。ただし黙ってはやらない。
dangling="$(find "$WORK/lib/firmware" -xtype l | wc -l)"
if [ "$dangling" -ne 0 ]; then
    echo "myos-mkfwinit: 行き先の無いリンクを $dangling 本外します" >&2
    find "$WORK/lib/firmware" -xtype l >&2
    find "$WORK/lib/firmware" -xtype l -delete
fi

# --- cpio に固める --------------------------------------------------------
# 中身はもう圧縮済みなので gzip は効かない。それでも通しておくのは
# インストーラ側の initramfs と形を揃えて、扱いを 1 つにしておくため。
( cd "$WORK" && find . | cpio -o -H newc --quiet ) | gzip -1 > "$OUT"

sz="$(wc -c < "$OUT")"
echo "myos-mkfwinit: ok  $OUT  $((sz / 1024 / 1024)) MB"
