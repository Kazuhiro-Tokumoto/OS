#!/bin/sh
# ============================================================================
# myos-install-init  -  インストーラ live 環境の PID 1
#
# initramfs が squashfs へ switch_root した直後にこれが動く。
# Windows 98 と同じ順で進める。
#   前半: 青いテキスト画面 (ディスクの選択とフォーマット)
#   後半: GUI のウィザード (ファイルのコピー)
# ============================================================================
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

mount -t proc     proc /proc 2>/dev/null
mount -t sysfs    sys  /sys  2>/dev/null
mount -t devtmpfs dev  /dev  2>/dev/null
mkdir -p /dev/pts /run /tmp
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs  tmpfs  /run     2>/dev/null
mount -t tmpfs  tmpfs  /tmp     2>/dev/null

# 起動メディア。initramfs が /myos-medium に置いてくれている。
# /run に tmpfs を被せた *あと* に bind すること。順番を逆にすると、
# tmpfs がこれを覆い隠してしまい、インストーラから中身が見えなくなる。
mkdir -p /run/myos
mount --bind /myos-medium /run/myos 2>/dev/null
if [ ! -f /run/myos/myos.squashfs ]; then
    echo                                             > /dev/console
    echo "  The installation medium is not visible." > /dev/console
    echo "  Expected /run/myos/myos.squashfs."       > /dev/console
    echo                                             > /dev/console
    exec /bin/sh < /dev/console > /dev/console 2>&1
fi

hostname myos-installer

# 入力デバイスは udev が居ないと X から見えない。
#
# settle は最大 10 秒待つ。その間に何も出さないと画面が止まって
# 見えるので、ここでも点を回しておく。
# (initramfs 側と同じ調子。あちらは別のプロセスなので状態は引き継げない)
if [ -x /lib/systemd/systemd-udevd ]; then
    printf '  Booting now' > /dev/console
    /lib/systemd/systemd-udevd --daemon
    udevadm trigger --action=add >/dev/null 2>&1
    udevadm settle --timeout=10 >/dev/null 2>&1 &
    settle_pid=$!
    n=0
    while kill -0 "$settle_pid" 2>/dev/null; do
        if [ "$n" -ge 3 ]; then
            printf '\b \b\b \b\b \b' > /dev/console
            n=0
        else
            printf '.' > /dev/console
            n=$((n + 1))
        fi
        sleep 1
    done
    wait "$settle_pid" 2>/dev/null
    while [ "$n" -gt 0 ]; do
        printf '\b \b' > /dev/console
        n=$((n - 1))
    done
    echo > /dev/console
fi

# --- 前半: 青いテキスト画面 ---------------------------------------------
# コンソールに直接出す。X はまだ上げない。
/usr/local/bin/myos-install-text < /dev/console > /dev/console 2>&1
rc=$?

if [ "$rc" != "0" ] || [ ! -f /tmp/myos-install.conf ]; then
    echo                                        > /dev/console
    echo "  Setup was cancelled."               > /dev/console
    echo "  Restart the computer, or use this shell." > /dev/console
    echo                                        > /dev/console
    exec /bin/sh < /dev/console > /dev/console 2>&1
fi

# --- 後半: GUI のウィザード ---------------------------------------------
echo "  Starting the graphical part of Setup..." > /dev/console

# X の出力はコンソールに出さない。ここを /dev/console にしていたため、
# ウィザードが終わったあとに Xorg のログが画面いっぱいに散らかっていた。
# 見たくなったときのために取ってはおく。
#
# exec もしない。exec すると xinit が終わった時点で PID 1 が消え、
# カーネルパニックになる。必ずこの下に戻ってくるようにする。
/usr/bin/xinit /usr/local/bin/myos-install-session -- \
     /usr/bin/X :0 vt1 -nolisten tcp -novtswitch \
     > /var/log/Xorg-install.log 2>&1
rc=$?

# 普通は myos-install-gui が myos-poweroff を呼んで再起動するので、
# ここには来ない。来たということは、途中でやめたか再起動に失敗したか。
printf '\033[2J\033[H'                                   > /dev/console
echo                                                      > /dev/console
echo "  Setup has ended (X exited with $rc)."             > /dev/console
echo "  Restart the computer."                             > /dev/console
echo                                                      > /dev/console
echo "  A shell is available here if you need to look."   > /dev/console
echo "  The X log is in /var/log/Xorg-install.log."       > /dev/console
echo                                                      > /dev/console
exec /bin/sh < /dev/console > /dev/console 2>&1
